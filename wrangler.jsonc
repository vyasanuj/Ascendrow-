{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "ascendrow",
	"compatibility_date": "2026-09-08",
	"compatibility_flags": [ "nodejs_compat" ],

	// Static site: Cloudflare serves ./dist straight from the edge. There is no
	// Worker script, so no `main` entry. When the contact form lands and the
	// Cloudflare adapter is re-enabled in astro.config.mjs, restore:
	//   "main": "@astrojs/cloudflare/entrypoints/server",
	//   "assets": { "directory": "./dist", "binding": "ASSETS" }
	"assets": {
		"directory": "./dist",
		// Serve /about instead of /about/index.html, and 404.html for misses
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	},

	"vars": {
		"KEYSTATIC_GITHUB_CLIENT_ID": "Iv23lizRxNAU1OYvmYQp",
		"PUBLIC_KEYSTATIC_GITHUB_APP_SLUG": "vyasanuj-keystatic"
	},
	"observability": {
		"enabled": true
	}
}
