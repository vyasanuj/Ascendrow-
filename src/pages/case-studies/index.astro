---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/sections/Footer.astro';
---

<Layout title="Case Studies — Ascendrow" description="See the real results and revenue we've driven for our clients.">
  <main>
    <section
      style="background-color: #0F0F14; min-height: 100vh; position: relative; overflow: hidden; padding: clamp(120px, 10vw, 160px) clamp(20px, 4vw, 56px) clamp(64px, 8vw, 120px); color: #F8F7FB; font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
    >
      <div style="position: relative; max-width: 1180px; margin: 0 auto;">
        
        <div style="text-align: center; margin-bottom: clamp(64px, 8vw, 96px);">
          <div style="display: inline-flex; align-items: center; gap: 8px; margin-bottom: 24px; padding: 8px 16px; border-radius: 999px; border: 1px solid rgba(110,86,207,.4); background: rgba(110,86,207,.15); font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: #A895FF;">
            <span style="width: 6px; height: 6px; border-radius: 50%; background: #A895FF; box-shadow: 0 0 10px #A895FF;"></span>
            Case Studies
          </div>
          <h1 style="font-size: clamp(40px, 5vw, 64px); font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; margin: 0 auto; max-width: 20ch; text-wrap: balance;">
            Results that speak for themselves.
          </h1>
          <p style="font-size: clamp(18px, 1.5vw, 22px); line-height: 1.6; color: rgba(255,255,255,0.7); margin: 24px auto 0; max-width: 50ch;">
            Explore how we've helped high-consideration brands automate their sales, rebuild their pipeline, and drive tangible revenue.
          </p>
        </div>

        <!-- Case Studies Grid -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 32px;">
          
          <!-- Rotimatic Case Study Card -->
          <a href="/case-studies/rotimatic" style="display: flex; flex-direction: column; background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 16px; padding: 40px; text-decoration: none; transition: all 0.3s ease; position: relative; overflow: hidden; group" onmouseover="this.style.background='rgba(255,255,255,0.06)'; this.style.borderColor='rgba(110,86,207,0.5)'; this.style.transform='translateY(-4px)'" onmouseout="this.style.background='rgba(255,255,255,0.03)'; this.style.borderColor='rgba(255,255,255,0.1)'; this.style.transform='translateY(0)'">
            <!-- Subtle glow inside card -->
            <div style="position: absolute; top: 0; left: 0; right: 0; height: 50%; background: radial-gradient(circle at top, rgba(110,86,207,0.15) 0%, transparent 70%); pointer-events: none;"></div>
            
            <div style="position: relative; z-index: 2;">
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 32px;">
                <div style="background: #FFF; padding: 6px 12px; border-radius: 6px; display: inline-flex; align-items: center; justify-content: center;">
                  <img src="/brands/Rotimatic_Logo_.png" alt="Rotimatic Logo" style="height: 24px; width: auto; max-width: 120px; object-fit: contain; display: block;" />
                </div>
                <div style="width: 40px; height: 40px; border-radius: 50%; background: rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: center; color: #FFF;">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                    <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
              </div>

              <h2 style="font-size: 28px; font-weight: 800; color: #FFF; margin: 0 0 16px 0; line-height: 1.2;">
                Transforming the sales pipeline for a global premium appliance brand.
              </h2>
              <p style="font-size: 16px; line-height: 1.6; color: rgba(255,255,255,0.7); margin: 0 0 32px 0;">
                By acting as an extension of the internal team, we rebuilt the sales pipeline, automated support, and generated $165K in revenue in just a month.
              </p>

              <div style="display: flex; gap: 24px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,0.1);">
                <div>
                  <div style="font-family: 'JetBrains Mono', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: #A895FF; margin-bottom: 4px;">Revenue</div>
                  <div style="font-size: 20px; font-weight: 800; color: #FFF;">$165K</div>
                </div>
                <div>
                  <div style="font-family: 'JetBrains Mono', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: #A895FF; margin-bottom: 4px;">Pipeline</div>
                  <div style="font-size: 20px; font-weight: 800; color: #FFF;">$450K</div>
                </div>
              </div>
            </div>
          </a>

        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
