---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/hero/ServiceHero';
import Navbar from '../../components/sections/Navbar.astro';
import Footer from '../../components/sections/Footer.astro';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map(service => ({
    params: { id: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const data = service.data;

// Fetch case studies for the new dynamic section
const allCaseStudies = await getCollection('case-studies');
const relatedCaseStudies = allCaseStudies.slice(0, 2);
---

<Layout title={data.seo.title}>
  <section style="background: #0F0F14; color: #F8F7FB; position: relative; overflow: hidden; padding: clamp(12px, 1.6vw, 20px) clamp(16px, 3vw, 48px) clamp(36px, 4vw, 60px);">
    <!-- ambient glows -->
    <div style="position: absolute; top: -300px; left: 50%; transform: translateX(-50%); width: min(1100px, 130%); height: 780px; border-radius: 50%; background: radial-gradient(circle, rgba(110,86,207,.20), rgba(110,86,207,0) 66%); pointer-events: none; animation: ascGlow 9s ease-in-out infinite;"></div>
    <div style="position: absolute; bottom: -320px; right: -180px; width: 720px; height: 640px; border-radius: 50%; background: radial-gradient(circle, rgba(255,107,74,.13), rgba(255,107,74,0) 68%); pointer-events: none;"></div>
    <div style="position: absolute; bottom: -320px; left: -220px; width: 640px; height: 600px; border-radius: 50%; background: radial-gradient(circle, rgba(110,86,207,.10), rgba(110,86,207,0) 70%); pointer-events: none;"></div>

    <div style="position: relative; max-width: 1240px; margin: 0 auto; width: 100%; z-index: 40; min-height: 56px;">
      <Navbar />
    </div>

    <!-- Hero Section Wrapper to contain cursor glow -->
    <div id="hero-wrapper" style="position: relative; width: 100%; overflow: hidden;">
      <!-- Cursor Glow Interactive Background -->
      <div id="service-cursor-glow" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 10; mix-blend-mode: screen; opacity: 1;">
        <!-- Subtle, elegant glow -->
        <div id="service-glow-orb" style="position: absolute; width: 800px; height: 800px; top: 0; left: 0; background: radial-gradient(circle, rgba(255, 107, 74, 0.25) 0%, rgba(110, 86, 207, 0.15) 30%, transparent 70%); border-radius: 50%; filter: blur(100px); will-change: transform;"></div>
      </div>

      <!-- Minimal Header with Subtle Pattern Background -->
      <div style="position: relative; max-width: 1320px; margin: 80px auto 60px; z-index: 20; padding: 60px 0; text-align: left;">
        <!-- Subtle Grid Pattern with Fade (Left Aligned Mask) -->
        <div style="
          position: absolute;
          inset: -80px -100px;
          z-index: -1;
          background-image: 
            linear-gradient(rgba(255, 255, 255, 0.15) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255, 255, 255, 0.15) 1px, transparent 1px);
          background-size: 32px 32px;
          -webkit-mask-image: radial-gradient(ellipse 60% 60% at 20% 50%, black 0%, transparent 100%);
          mask-image: radial-gradient(ellipse 60% 60% at 20% 50%, black 0%, transparent 100%);
          pointer-events: none;
        "></div>

        <span style="font-size: clamp(14px, 1.2vw, 16px); color: rgba(255,255,255,0.5); font-weight: 500; display: block;">
          {data.seo.title.split('|')[0].trim()}
        </span>
        
        <h1 style="font-size: clamp(40px, 5.5vw, 64px); font-weight: 600; margin: 16px 0 0; color: #fff; letter-spacing: -0.02em; line-height: 1.1; max-width: 900px;">
          {data.hero.mainHeading || data.seo.description}
          {data.hero.mainHeadingHighlight && (
            <span style="color: #FF6B4A;"> {data.hero.mainHeadingHighlight}</span>
          )}
        </h1>
      </div>

      <ServiceHero client:load folders={data.hero.folders} />
    </div>

    <!-- Dynamic Case Studies Section -->
    <div style="position: relative; z-index: 20; max-width: 1320px; margin: 0 auto; padding: clamp(60px, 8vw, 120px) clamp(16px, 3vw, 24px);">
      <div style="display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 64px; flex-wrap: wrap; gap: 24px;">
        <div>
          <h2 style="font-size: clamp(32px, 4vw, 48px); font-weight: 600; color: #fff; margin: 0 0 16px; letter-spacing: -0.02em;">
            Proven <span style="color: #A895FF;">Results</span>
          </h2>
          <p style="color: rgba(255,255,255,0.7); font-size: clamp(16px, 1.2vw, 18px); margin: 0; max-width: 500px; line-height: 1.6;">
            See how we've helped companies scale revenue and build better products using our {data.seo.title.split('|')[0].trim().toLowerCase()} expertise.
          </p>
        </div>
        <a href="/case-studies" style="display: inline-flex; align-items: center; gap: 8px; padding: 12px 24px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 99px; color: #fff; text-decoration: none; font-size: 14px; font-weight: 500; transition: all 0.3s ease;" onmouseover="this.style.background='rgba(255,255,255,0.1)'" onmouseout="this.style.background='rgba(255,255,255,0.05)'">
          View all work
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <style>
        .staggered-grid {
          display: grid;
          grid-template-columns: 1fr;
          gap: 64px;
          align-items: start;
        }
        @media (min-width: 768px) {
          .staggered-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 40px;
          }
          .staggered-card:nth-child(even) {
            margin-top: clamp(60px, 10vw, 140px);
          }
          .staggered-card:nth-child(odd) .staggered-img {
            aspect-ratio: 16/10 !important;
          }
          .staggered-card:nth-child(even) .staggered-img {
            aspect-ratio: 4/3 !important;
          }
        }
      </style>

      <div class="staggered-grid">
        {relatedCaseStudies.map((study) => (
          <a href={`/case-studies/${study.id}`} class="staggered-card" style="display: flex; flex-direction: column; text-decoration: none; position: relative; overflow: visible;">
            
            <!-- Image Placeholder -->
            <div class="staggered-img" style="width: 100%; aspect-ratio: 16/11; background: rgba(255,255,255,0.02); border-radius: 16px; margin-bottom: 24px; position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; border: 1px dashed rgba(255,255,255,0.15); transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1); will-change: transform;" onmouseover="this.style.transform='scale(1.02)'" onmouseout="this.style.transform='scale(1)'">
              <div style="position: absolute; inset: 0; background: radial-gradient(circle at center, rgba(255,255,255,0.03) 0%, transparent 70%); pointer-events: none;"></div>
              <div style="display: flex; flex-direction: column; align-items: center; gap: 12px; color: rgba(255,255,255,0.3);">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                <span style="font-size: 13px; font-family: 'JetBrains Mono', monospace; text-transform: uppercase; letter-spacing: 0.1em;">Image Placeholder</span>
              </div>
            </div>

            <!-- Content -->
            <div style="display: flex; flex-direction: column; padding: 0 4px;">
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 13px; text-transform: uppercase; letter-spacing: 0.05em; color: rgba(255,255,255,0.5); margin-bottom: 12px;">
                {study.data.metadata?.client?.name || study.data.seo.title.split('|')[0].trim()}
              </span>
              <h3 style="font-size: clamp(20px, 2vw, 26px); font-weight: 600; color: #FFF; margin: 0; line-height: 1.4; letter-spacing: -0.01em; transition: color 0.3s ease;" onmouseover="this.style.color='#A895FF'" onmouseout="this.style.color='#FFF'">
                {study.data.hero?.headlineText || study.data.seo.title.split('|')[0].trim()}
              </h3>
            </div>
          </a>
        ))}
      </div>
    </div>



    <!-- Process Horizontal Scroll Section -->
    {data.process && data.process.length > 0 && (
      <section id="process-horizontal-section" style="position: relative; width: 100%; overflow: hidden; background: #0A0A0F; padding: clamp(60px, 8vw, 120px) 0;">
        
        <!-- Section Header -->
        <div style="position: relative; max-width: 1320px; margin: 0 auto 40px; padding: 0 clamp(16px, 3vw, 24px); text-align: left;" class="process-header-anim">
          <span style="font-size: clamp(14px, 1.2vw, 16px); color: rgba(255,255,255,0.5); font-weight: 500; display: block; margin-bottom: 16px;">
            Our Process
          </span>
          <h2 style="font-size: clamp(40px, 5.5vw, 64px); font-weight: 600; color: #fff; margin: 0; letter-spacing: -0.02em; line-height: 1.1; max-width: 900px;">
            A proven framework for <span style="color: #A895FF; font-style: italic; font-weight: 400;">predictable</span> results.
          </h2>
        </div>

        <style>
          .process-wrapper {
            width: 100%;
            height: auto;
            display: flex;
            flex-direction: column;
            align-items: center;
            overflow: visible;
            position: relative;
          }
          .process-container {
            display: flex;
            flex-direction: row;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            -webkit-overflow-scrolling: touch;
            width: 100%;
            position: relative;
            gap: 16px;
            padding: 0 16px 40px 16px;
            scrollbar-width: none;
          }
          .process-container::-webkit-scrollbar {
            display: none;
          }
          .process-panel {
            width: 85vw;
            background: #FFF;
            border-radius: 24px;
            display: flex;
            align-items: center;
            justify-content: flex-start;
            padding: 40px 24px;
            flex-shrink: 0;
            gap: 32px;
            flex-direction: column;
            text-align: center;
            scroll-snap-align: center;
          }
          .process-text {
            flex: 1;
            max-width: 600px;
            display: flex;
            flex-direction: column;
            align-items: center;
          }
          .process-title {
            font-size: clamp(28px, 6vw, 32px);
            font-weight: 600;
            color: #000;
            margin: 0 0 16px;
            letter-spacing: -0.01em;
          }
          .process-desc {
            font-size: 16px;
            line-height: 1.6;
            color: rgba(0,0,0,0.7);
            margin: 0;
          }
          .process-step-number {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 48px;
            height: 48px;
            border-radius: 50%;
            border: 1px solid rgba(0,0,0,0.1);
            background: rgba(0,0,0,0.05);
            font-family: 'JetBrains Mono', monospace;
            font-size: 16px;
            color: #000;
            margin-bottom: 24px;
          }
          .process-rune-side {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            max-width: 400px;
            min-height: 150px;
          }
          .panel-glow {
            position: absolute;
            width: 150px;
            height: 150px;
            background: radial-gradient(circle at center, rgba(168,149,255,0.15) 0%, transparent 70%);
            filter: blur(20px);
          }
          .panel-rune {
            width: 100%;
            height: 100%;
            position: relative;
            z-index: 2;
            max-width: 120px;
          }
          .process-dots {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 16px;
          }
          .process-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            transition: all 0.3s ease;
          }
          .process-dot.active {
            width: 24px;
            border-radius: 4px;
            background: #A895FF;
          }
          @media (min-width: 768px) {
            .process-dots { display: none; }
            .process-wrapper {
              flex-direction: row;
              height: 55vh;
              min-height: 450px;
              align-items: center;
              justify-content: flex-start;
              overflow: hidden;
            }
            .process-container {
              flex-direction: row;
              overflow-x: visible;
              height: 100%;
              width: auto;
              gap: 0;
              padding: 0;
            }
            .process-panel {
              width: 100vw;
              height: 100%;
              flex-direction: row;
              padding: 0 5vw;
              gap: clamp(40px, 8vw, 120px);
              background: transparent;
              border-radius: 0;
              scroll-snap-align: none;
              justify-content: center;
            }
            .process-text { 
              text-align: left; 
              align-items: flex-start; 
            }
            .process-title {
              font-size: clamp(32px, 4vw, 56px);
              color: #FFF;
              margin: 0 0 24px;
            }
            .process-desc {
              font-size: clamp(18px, 1.5vw, 22px);
              color: rgba(255,255,255,0.6);
            }
            .process-step-number {
              width: 60px;
              height: 60px;
              border: 1px solid rgba(255,255,255,0.1);
              background: rgba(255,255,255,0.02);
              font-size: 18px;
              color: #FFF;
              margin-bottom: 32px;
            }
            .process-rune-side { min-height: 300px; }
            .panel-glow { width: 300px; height: 300px; filter: blur(40px); }
            .panel-rune { max-width: 250px; }
          }
        </style>

        <!-- Horizontal Scroll Wrapper -->
        <div id="horizontal-scroll-wrapper" class="process-wrapper">
          <div id="horizontal-scroll-container" class="process-container">
            
            <!-- Graph removed temporarily -->
            
            {data.process.map((step, index) => (
              <div class="process-panel">
                
                <!-- Rune Side -->
                <div class="process-rune-side">
                  <div class="panel-glow"></div>
                  
                  {index === 0 && (
                    <svg class="panel-rune" viewBox="0 0 100 100" fill="none" stroke="#A895FF" stroke-width="2">
                      <circle cx="50" cy="50" r="12" />
                      <ellipse cx="50" cy="50" rx="40" ry="20" />
                      <path d="M 50 10 L 50 20 M 50 80 L 50 90 M 10 50 L 20 50 M 80 50 L 90 50" stroke-width="1" opacity="0.5" />
                    </svg>
                  )}
                  {index === 1 && (
                    <svg class="panel-rune" viewBox="0 0 100 100" fill="none" stroke="#4A90E2" stroke-width="2">
                      <polygon points="50 20 90 80 10 80" />
                      <line x1="10" y1="60" x2="90" y2="60" />
                      <line x1="30" y1="80" x2="30" y2="90" stroke-width="1" />
                      <line x1="70" y1="80" x2="70" y2="90" stroke-width="1" />
                      <circle cx="50" cy="45" r="5" />
                    </svg>
                  )}
                  {index === 2 && (
                    <svg class="panel-rune" viewBox="0 0 100 100" fill="none" stroke="#FF6B4A" stroke-width="2">
                      <path d="M 50 10 Q 50 50 90 50 Q 50 50 50 90 Q 50 50 10 50 Q 50 50 50 10 Z" />
                      <circle cx="50" cy="50" r="8" />
                      <circle cx="20" cy="20" r="2" fill="#FF6B4A" />
                      <circle cx="80" cy="80" r="2" fill="#FF6B4A" />
                    </svg>
                  )}
                  {index === 3 && (
                    <svg class="panel-rune" viewBox="0 0 100 100" fill="none" stroke="#FFF" stroke-width="2">
                      <circle cx="35" cy="50" r="25" />
                      <circle cx="65" cy="50" r="25" />
                      <circle cx="50" cy="50" r="5" fill="#FFF" />
                      <line x1="10" y1="50" x2="0" y2="50" />
                      <line x1="90" y1="50" x2="100" y2="50" />
                    </svg>
                  )}
                  {index > 3 && (
                    <svg class="panel-rune" viewBox="0 0 100 100" fill="none" stroke="#A895FF" stroke-width="2">
                      <circle cx="50" cy="50" r="40" stroke-dasharray="10 10" />
                      <circle cx="50" cy="50" r="20" />
                    </svg>
                  )}
                </div>

                <!-- Text Side -->
                <div class="process-text">
                  <div class="process-step-number">
                    {step.step}
                  </div>
                  <h3 class="process-title">
                    {step.title}
                  </h3>
                  <p class="process-desc">
                    {step.description}
                  </p>
                </div>
                
              </div>
            ))}
            
          </div>

          <!-- Mobile Dotted Navigation -->
          <div class="process-dots">
            {data.process.map((_, i) => (
              <div class={`process-dot ${i === 0 ? 'active' : ''}`} data-index={i}></div>
            ))}
          </div>

        </div>
      </section>
    )}

    <!-- Growth Impact Motion Graphic Section -->
    <style>
      .growth-section { height: auto; padding: 120px 0; }
      .growth-headline { position: relative; margin-bottom: 64px; inset: auto; }
      .growth-bars { position: relative; height: 400px; bottom: auto; }
      .growth-pinned { height: 100%; min-height: 100vh; }
      @media (min-width: 768px) {
        .growth-section { height: 180vh; padding: 0; }
        .growth-headline { position: absolute; inset: 0; margin-bottom: 0; }
        .growth-bars { position: absolute; bottom: 10vh; height: 60vh; }
        .growth-pinned { height: 100vh; }
      }
    </style>
    <div id="growth-motion-section" class="growth-section" style="position: relative; width: 100%; background: #0A0A0F; color: #FFF; overflow: visible;">
      <div id="growth-pinned-container" class="growth-pinned" style="width: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; overflow: hidden;">
        
        <!-- Massive Typography Background -->
        <div id="growth-bg-text" style="position: absolute; top: 50%; left: 100%; transform: translateY(-50%); font-size: 28vw; font-weight: 800; color: rgba(255,255,255,0.02); white-space: nowrap; font-family: 'Plus Jakarta Sans', sans-serif; user-select: none;">
          IMPACT
        </div>

        <!-- Central Headline that fades out on Desktop -->
        <div id="growth-headline" class="growth-headline" style="z-index: 5; text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: center;">
          <h2 style="font-size: clamp(40px, 6vw, 80px); font-weight: 700; color: #FFF; letter-spacing: -0.03em; max-width: 900px; text-wrap: balance; margin: 0; text-shadow: 0 10px 40px rgba(0,0,0,0.8); line-height: 1.1;">
              {data.growthSection?.headlinePrimary || "Design isn't just art."}<br />
              <span style="color: rgba(255,255,255,0.4);">{data.growthSection?.headlineSecondary || "It's a growth engine."}</span>
            </h2>
        </div>

        <!-- The Ascending Bars Chart -->
        <div class="growth-bars" style="display: flex; align-items: flex-end; justify-content: center; gap: clamp(20px, 4vw, 60px); width: 100%; max-width: 1100px; margin: 0 auto; z-index: 10; padding: 0 20px;">
          
          {(data.growthSection?.metrics ?? [
            { value: "98%", label: "Customer Satisfaction", color: "#4A90E2", colorRgb: "74,144,226", barHeight: "35%" },
            { value: "10x", label: "Faster Time-to-Market", color: "#A895FF", colorRgb: "168,149,255", barHeight: "65%" },
            { value: "+$2.4M", label: "Additional Revenue", color: "#FF6B4A", colorRgb: "255,107,74", barHeight: "100%" }
          ]).map((metric: any) => (
            <div style="display: flex; flex-direction: column; align-items: center; justify-content: flex-end; flex: 1; height: 100%; position: relative;">
              <div class="growth-metric" style="text-align: center; margin-bottom: 24px; position: relative; z-index: 2;">
                <div style="font-size: clamp(32px, 4vw, 56px); font-weight: 800; color: #FFF; line-height: 1; text-shadow: 0 10px 30px rgba(0,0,0,0.5);">{metric.value}</div>
                <div style={`font-family: 'JetBrains Mono', monospace; font-size: clamp(10px, 1.2vw, 14px); color: ${metric.color}; text-transform: uppercase; letter-spacing: 0.1em; margin-top: 8px;`}>{metric.label}</div>
              </div>
              <div class="growth-bar" style={`width: 100%; height: ${metric.barHeight}; background: linear-gradient(180deg, rgba(${metric.colorRgb},0.3) 0%, rgba(${metric.colorRgb},0.05) 100%); border-top: 2px solid ${metric.color}; border-radius: 16px 16px 0 0; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); box-shadow: 0 -10px 40px rgba(${metric.colorRgb},0.2);`}></div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- The Arsenal Section (Tech Stack) -->
  {data.arsenal && data.arsenal.length > 0 && (
    <section style="background: #0F0F14; position: relative; padding: clamp(60px, 8vw, 120px) clamp(16px, 3vw, 48px); border-top: 1px solid rgba(255,255,255,0.05); overflow: hidden;">
      
      <!-- Background Ambient Glow -->
      <div style="position: absolute; top: -200px; left: 50%; transform: translateX(-50%); width: 80vw; height: 400px; background: radial-gradient(ellipse at center, rgba(168,149,255,0.1) 0%, transparent 70%); filter: blur(60px); pointer-events: none; z-index: 0;"></div>

      <div style="max-width: 1440px; margin: 0 auto; position: relative; z-index: 2;">
        
        <!-- Header -->
        <div style="text-align: left; margin-bottom: clamp(40px, 6vw, 80px);">
          <span style="font-size: clamp(14px, 1.2vw, 16px); color: rgba(255,255,255,0.5); font-weight: 500; display: block; margin-bottom: 16px;">
            Our Arsenal
          </span>
          <h2 style="font-size: clamp(40px, 5.5vw, 64px); font-weight: 600; color: #fff; margin: 0; letter-spacing: -0.02em; line-height: 1.1; max-width: 900px;">
            The tech stack that powers <br /> <span style="color: #A895FF; font-style: italic; font-weight: 400;">premium</span> experiences.
          </h2>
        </div>

        <!-- Grid -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 24px;">
          {data.arsenal.map((tool) => (
            <div class="arsenal-card" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: 24px; padding: 40px; backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); cursor: crosshair; position: relative; overflow: hidden; display: flex; flex-direction: column; gap: 16px;">
              
              <!-- Spotlight overlay injected by JS -->
              <div class="arsenal-spotlight" style="position: absolute; inset: 0; background: radial-gradient(circle 300px at var(--x, 50%) var(--y, 50%), rgba(168,149,255,0.1), transparent 80%); opacity: 0; transition: opacity 0.3s ease; pointer-events: none; z-index: 1;"></div>
              
              <div style="position: relative; z-index: 2;">
                <div style="font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #A895FF; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 8px;">{tool.category}</div>
                <h3 style="font-size: 28px; font-weight: 600; color: #FFF; margin: 0 0 16px 0;">{tool.name}</h3>
                <p style="font-size: 16px; color: rgba(255,255,255,0.6); line-height: 1.5; margin: 0;">
                  {tool.description}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ Section -->
  {data.faq && data.faq.length > 0 && (
    <section style="background: #0F0F14; padding: clamp(60px, 8vw, 120px) clamp(16px, 3vw, 48px); border-top: 1px solid rgba(255,255,255,0.05);">
      <div style="max-width: 1440px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 64px; justify-content: space-between;">
        
        <!-- Header (Left Column) -->
        <div style="text-align: left; flex: 1; min-width: min(100%, 300px); max-width: 500px; margin-bottom: clamp(20px, 4vw, 40px);">
          <span style="font-size: clamp(14px, 1.2vw, 16px); color: rgba(255,255,255,0.5); font-weight: 500; display: block; margin-bottom: 16px;">
            Clear The Air
          </span>
          <h2 style="font-size: clamp(40px, 5.5vw, 64px); font-weight: 600; color: #fff; margin: 0; letter-spacing: -0.02em; line-height: 1.1;">
            Frequently Asked <br /> <span style="color: #A895FF; font-style: italic; font-weight: 400;">Questions.</span>
          </h2>
        </div>

        <!-- Accordion List (Right Column) -->
        <div class="faq-accordion" style="display: flex; flex-direction: column; gap: 16px; flex: 2; min-width: min(100%, 300px);">
          {data.faq.map((item, index) => (
            <div class="faq-item" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 16px; overflow: hidden; transition: background 0.3s ease;">
              
              <button class="faq-question" style="width: 100%; text-align: left; background: none; border: none; padding: clamp(16px, 4vw, 32px); display: flex; align-items: center; justify-content: space-between; cursor: pointer; color: #FFF;">
                <span style="font-size: clamp(18px, 2vw, 24px); font-weight: 500; padding-right: 24px; line-height: 1.3;">
                  {item.question}
                </span>
                <span class="faq-icon" style="flex-shrink: 0; width: 32px; height: 32px; border-radius: 50%; border: 1px solid rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; position: relative;">
                  <span class="faq-icon-h" style="position: absolute; width: 12px; height: 2px; background: #FFF;"></span>
                  <span class="faq-icon-v" style="position: absolute; width: 2px; height: 12px; background: #FFF;"></span>
                </span>
              </button>

              <div class="faq-answer-wrapper" style="height: 0; overflow: hidden;">
                <div class="faq-answer-content" style="padding: 0 clamp(16px, 4vw, 32px) clamp(16px, 4vw, 32px) clamp(16px, 4vw, 32px); font-size: 18px; color: rgba(255,255,255,0.6); line-height: 1.6;">
                  {item.answer}
                </div>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>
  )}

  <!-- Final Interactive CTA ("The Black Hole") -->
  <section id="cta-section" style="position: relative; width: 100%; height: 100vh; min-height: 800px; background: #07070A; overflow: hidden; display: flex; align-items: center; justify-content: center; cursor: crosshair;">
    
    <!-- The Glowing Black Hole Orb -->
    <div id="cta-orb" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: min(400px, 80vw); height: min(400px, 80vw); border-radius: 50%; background: radial-gradient(circle at center, rgba(168,149,255,0.4) 0%, rgba(74,144,226,0.1) 40%, transparent 70%); filter: blur(50px); pointer-events: none; z-index: 1;"></div>
    
    <!-- A dense core inside the orb for contrast -->
    <div id="cta-orb-core" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 100px; height: 100px; border-radius: 50%; background: #000; box-shadow: 0 0 100px 20px #A895FF, inset 0 0 40px #000; pointer-events: none; z-index: 2; opacity: 0; transition: opacity 0.5s ease;"></div>

    <!-- Content -->
    <div style="position: relative; z-index: 10; text-align: center; display: flex; flex-direction: column; align-items: center;">
      <h2 style="font-size: clamp(48px, 8vw, 120px); font-weight: 700; color: #FFF; margin: 0 0 24px 0; letter-spacing: -0.04em; line-height: 1; text-shadow: 0 10px 40px rgba(0,0,0,0.8);">
        {data.cta?.headline || "Ready to scale?"}
      </h2>
      <p style="font-size: clamp(18px, 2vw, 24px); color: rgba(255,255,255,0.6); max-width: 600px; margin: 0 0 48px 0; line-height: 1.5;">
        {data.cta?.subtext || "Stop losing users to friction. Let's design an experience that converts."}
      </p>
      
      <a href={data.cta?.buttonHref || "/contact"} id="cta-button" style="display: inline-flex; align-items: center; justify-content: center; padding: 20px 48px; font-size: 18px; font-weight: 600; color: #FFF; text-decoration: none; border-radius: 100px; border: 1px solid rgba(255,255,255,0.2); background: rgba(255,255,255,0.05); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); transition: all 0.3s ease; position: relative; overflow: hidden;">
        <span style="position: relative; z-index: 2;">{data.cta?.buttonText || "Start your project"}</span>
      </a>
    </div>
  </section>
  <Footer />
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Robust initialization to ensure it runs
  function initAnimations() {
    // 1. Cursor Glow
    const wrapper = document.getElementById('hero-wrapper');
    const orb = document.getElementById('service-glow-orb');
    
    if (wrapper && orb) {
      let mouseX = window.innerWidth / 2;
      let mouseY = window.innerHeight / 2;
      let currentX = mouseX;
      let currentY = mouseY;
      
      window.addEventListener('mousemove', (e) => {
        const rect = wrapper.getBoundingClientRect();
        mouseX = e.clientX - rect.left;
        mouseY = e.clientY - rect.top;
      });

      function animate() {
        currentX += (mouseX - currentX) * 0.08;
        currentY += (mouseY - currentY) * 0.08;
        orb.style.transform = `translate(-50%, -50%) translate3d(${currentX}px, ${currentY}px, 0)`;
        requestAnimationFrame(animate);
      }
      
      animate();
    }

    // 2. Process Section GSAP Animations
    // Header Reveal
    gsap.from('.process-header-anim', {
      y: 40,
      opacity: 0,
      duration: 1,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: '#process-horizontal-section',
        start: 'top 75%'
      }
    });

    // Mobile Process Swipe Dots Logic
    const swipePanels = document.querySelectorAll('.process-panel');
    const swipeDots = document.querySelectorAll('.process-dot');
    const swipeContainer = document.getElementById('horizontal-scroll-container');
    
    if (swipePanels.length > 0 && swipeDots.length > 0 && swipeContainer) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const index = Array.from(swipePanels).indexOf(entry.target);
            swipeDots.forEach((dot, i) => {
              if (i === index) dot.classList.add('active');
              else dot.classList.remove('active');
            });
          }
        });
      }, {
        root: swipeContainer,
        threshold: 0.6 
      });
      
      swipePanels.forEach(panel => observer.observe(panel));
    }

    let mm = gsap.matchMedia();

    mm.add("(min-width: 768px)", () => {
      // Horizontal Scroll Timeline
      const horizontalSection = document.getElementById('process-horizontal-section');
      const horizontalContainer = document.getElementById('horizontal-scroll-container');
      const horizontalPanels = gsap.utils.toArray('.process-panel');
      
      if (horizontalSection && horizontalContainer && horizontalPanels.length > 0) {
        
        const horizontalTl = gsap.to(horizontalPanels, {
          xPercent: -100 * (horizontalPanels.length - 1),
          ease: "none",
          scrollTrigger: {
            trigger: horizontalSection,
            pin: true,
            scrub: 1,
            end: () => "+=" + horizontalContainer.scrollWidth
          }
        });

        // Rotate runes as you scroll horizontally
        const runes = gsap.utils.toArray('.panel-rune');
        runes.forEach(rune => {
          gsap.to(rune, {
            rotation: 360,
            ease: "none",
            scrollTrigger: {
              trigger: horizontalSection,
              start: "top top",
              end: () => "+=" + horizontalContainer.scrollWidth,
              scrub: 1
            }
          });
        });
      }

      // 3. Growth Impact Motion Graphic
      const growthSection = document.getElementById('growth-motion-section');
      
      if (growthSection) {
        // Create a master timeline pinned to the section
        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: growthSection,
            start: "top top",
            end: "+=1200", 
            pin: '#growth-pinned-container',
            scrub: 1, 
          }
        });

        // 1. Fade out the initial headline
        tl.to('#growth-headline', { opacity: 0, scale: 0.9, duration: 1 }, 0);

        // 2. Move the massive background text
        tl.to('#growth-bg-text', { x: '-100vw', duration: 8 }, 0);

        // 3. Set initial states for bars and metrics
        const bars = gsap.utils.toArray('.growth-bar');
        const metrics = gsap.utils.toArray('.growth-metric');
        gsap.set(bars, { transformOrigin: "bottom center", scaleY: 0 });
        gsap.set(metrics, { opacity: 0, y: 40 });

        // 4. Stagger reveal bars and their metrics
        tl.to(bars[0], { scaleY: 1, duration: 2, ease: "power2.out" }, 1);
        tl.to(metrics[0], { opacity: 1, y: 0, duration: 1, ease: "power2.out" }, 1.5);
        
        tl.to(bars[1], { scaleY: 1, duration: 2, ease: "power2.out" }, 2.5);
        tl.to(metrics[1], { opacity: 1, y: 0, duration: 1, ease: "power2.out" }, 3);

        tl.to(bars[2], { scaleY: 1, duration: 2, ease: "power2.out" }, 4);
        tl.to(metrics[2], { opacity: 1, y: 0, duration: 1, ease: "power2.out" }, 4.5);
      }
    });

    // 4. Arsenal Spotlights & Magnetic Hover
    const arsenalCards = document.querySelectorAll('.arsenal-card');
    arsenalCards.forEach(card => {
      const spotlight = card.querySelector('.arsenal-spotlight');
      
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        
        // Move the internal spotlight gradient to follow the mouse
        spotlight.style.setProperty('--x', `${x}px`);
        spotlight.style.setProperty('--y', `${y}px`);
        spotlight.style.opacity = '1';
        
        // Calculate magnetic pull (move card slightly towards cursor)
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        const moveX = ((x - centerX) / centerX) * 12; // max 12px pull
        const moveY = ((y - centerY) / centerY) * 12;
        
        gsap.to(card, { x: moveX, y: moveY, duration: 0.3, ease: 'power2.out' });
      });
      
      card.addEventListener('mouseleave', () => {
        spotlight.style.opacity = '0';
        // Snap back to original position
        gsap.to(card, { x: 0, y: 0, duration: 0.5, ease: 'elastic.out(1, 0.3)' });
      });
    });

    // 5. FAQ Accordion Animation
    const faqItems = document.querySelectorAll('.faq-item');
    let activeFaq = null;

    faqItems.forEach((item) => {
      const question = item.querySelector('.faq-question');
      const answerWrapper = item.querySelector('.faq-answer-wrapper');
      const answerContent = item.querySelector('.faq-answer-content');
      const iconV = item.querySelector('.faq-icon-v');
      
      // Ensure initial state
      gsap.set(answerWrapper, { height: 0 });

      question.addEventListener('click', () => {
        const isOpen = item.classList.contains('is-open');

        // Close currently active one if a different one is clicked
        if (activeFaq && activeFaq !== item) {
          activeFaq.classList.remove('is-open');
          const activeWrapper = activeFaq.querySelector('.faq-answer-wrapper');
          const activeIconV = activeFaq.querySelector('.faq-icon-v');
          gsap.to(activeWrapper, { height: 0, duration: 0.5, ease: "power3.inOut" });
          gsap.to(activeIconV, { rotation: 0, duration: 0.5, ease: "power3.inOut" });
          activeFaq.style.background = 'rgba(255,255,255,0.02)';
        }

        if (!isOpen) {
          // Open
          item.classList.add('is-open');
          item.style.background = 'rgba(255,255,255,0.05)';
          gsap.to(answerWrapper, { 
            height: answerContent.offsetHeight, 
            duration: 0.5, 
            ease: "power3.inOut" 
          });
          gsap.to(iconV, { rotation: 90, duration: 0.5, ease: "power3.inOut" }); // Cross turns into a minus
          activeFaq = item;
        } else {
          // Close
          item.classList.remove('is-open');
          item.style.background = 'rgba(255,255,255,0.02)';
          gsap.to(answerWrapper, { height: 0, duration: 0.5, ease: "power3.inOut" });
          gsap.to(iconV, { rotation: 0, duration: 0.5, ease: "power3.inOut" });
          activeFaq = null;
        }
      });
    });

    // 6. The Black Hole CTA Animation
    const ctaSection = document.getElementById('cta-section');
    const ctaOrb = document.getElementById('cta-orb');
    const ctaOrbCore = document.getElementById('cta-orb-core');
    const ctaButton = document.getElementById('cta-button');

    if (ctaSection && ctaOrb && ctaButton) {
      let isHoveringButton = false;

      // Mouse tracking within the section
      ctaSection.addEventListener('mousemove', (e) => {
        const rect = ctaSection.getBoundingClientRect();
        const ctaMouseX = e.clientX - rect.left;
        const ctaMouseY = e.clientY - rect.top;

        if (!isHoveringButton) {
          // Ambient slow follow
          gsap.to([ctaOrb, ctaOrbCore], {
            x: ctaMouseX - rect.width / 2,
            y: ctaMouseY - rect.height / 2,
            duration: 2,
            ease: "power2.out"
          });
        }
      });

      // Reset to center when leaving section
      ctaSection.addEventListener('mouseleave', () => {
        if (!isHoveringButton) {
          gsap.to([ctaOrb, ctaOrbCore], { x: 0, y: 0, duration: 2, ease: "power2.out" });
        }
      });

      // The "Suck In" effect on button hover
      ctaButton.addEventListener('mouseenter', () => {
        isHoveringButton = true;
        
        // Calculate precise target center
        const sectionRect = ctaSection.getBoundingClientRect();
        const btnRect = ctaButton.getBoundingClientRect();
        const targetX = (btnRect.left + btnRect.width / 2) - (sectionRect.left + sectionRect.width / 2);
        const targetY = (btnRect.top + btnRect.height / 2) - (sectionRect.top + sectionRect.height / 2);

        // Snap orb behind button and expand intensely
        gsap.to(ctaOrb, {
          x: targetX,
          y: targetY,
          width: 800,
          height: 800,
          duration: 0.6,
          ease: "expo.out",
          background: "radial-gradient(circle at center, rgba(168,149,255,0.7) 0%, rgba(74,144,226,0.2) 50%, transparent 70%)"
        });
        
        // Ignite the black hole core
        gsap.to(ctaOrbCore, {
          x: targetX,
          y: targetY,
          opacity: 1,
          scale: 1.5,
          duration: 0.8,
          ease: "elastic.out(1, 0.5)"
        });

        // Button style changes
        gsap.to(ctaButton, {
          borderColor: "rgba(255,255,255,0.8)",
          background: "rgba(0,0,0,0.4)",
          scale: 1.05,
          duration: 0.3
        });
      });

      ctaButton.addEventListener('mouseleave', () => {
        isHoveringButton = false;
        
        // Deflate back to ambient state
        gsap.to(ctaOrb, {
          width: 400,
          height: 400,
          duration: 0.8,
          ease: "power2.out",
          background: "radial-gradient(circle at center, rgba(168,149,255,0.4) 0%, rgba(74,144,226,0.1) 40%, transparent 70%)"
        });
        
        gsap.to(ctaOrbCore, {
          opacity: 0,
          scale: 1,
          duration: 0.5
        });

        gsap.to(ctaButton, {
          borderColor: "rgba(255,255,255,0.2)",
          background: "rgba(255,255,255,0.05)",
          scale: 1,
          duration: 0.3
        });
      });
    }
  }

  // Ensure it runs after DOM is ready
  document.addEventListener('DOMContentLoaded', initAnimations);
  // Support Astro View Transitions if enabled
  document.addEventListener('astro:page-load', initAnimations);
</script>
