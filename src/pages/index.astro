---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/hero/Hero.astro';
import StatScroller from '../components/sections/StatScroller';
import Work from '../components/sections/Work.astro';
import Approach from '../components/sections/Approach.astro';
import Funnel from '../components/sections/Funnel.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import GlobalReach from '../components/sections/GlobalReach.astro';
import Contact from '../components/sections/Contact.astro';
import Footer from '../components/sections/Footer.astro';
---

<Layout
  title="Ascendrow — Growth systems for search, social and AI answers"
  description="Paid ads, SEO, branding and design run as one system that puts you in front of ready buyers, makes you the name they trust, and turns that trust into qualified leads."
>
  <main>
    <Hero />
    <StatScroller client:visible />
    <Work />
    <Approach />
    <Funnel />
    <Testimonials />
    <GlobalReach />
    <Contact />
  </main>
  <Footer />
</Layout>
