---
import { theme } from '../data/site';

// Self-hosted fonts. Vite copies each file to /_astro/<hash>.woff2 and hands
// back the path, so the @font-face below can point at same-origin assets.
// One variable file covers every Jakarta weight the site uses (400–800).
import jakartaWoff2 from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import mono400Woff2 from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url';
import mono500Woff2 from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-500-normal.woff2?url';

// Registered under the SAME family names the rest of the CSS already uses,
// so nothing else had to change. url() can't take a CSS variable, hence the
// string built here and inlined below.
const fontFaces = [
  `@font-face{font-family:'Plus Jakarta Sans';font-style:normal;font-weight:200 800;font-display:swap;src:url(${jakartaWoff2}) format('woff2-variations'),url(${jakartaWoff2}) format('woff2')}`,
  `@font-face{font-family:'JetBrains Mono';font-style:normal;font-weight:400;font-display:swap;src:url(${mono400Woff2}) format('woff2')}`,
  `@font-face{font-family:'JetBrains Mono';font-style:normal;font-weight:500;font-display:swap;src:url(${mono500Woff2}) format('woff2')}`,
].join('\n');

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- favicon.ico carries 16 + 32px and answers the bare /favicon.ico request
         browsers make regardless of these tags. Built by scripts/build-favicon.mjs. -->
    <link rel="icon" href="/icons/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icons/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />

    <!-- Fonts are self-hosted (see frontmatter). Preloading the body/heading
         face lets the browser fetch it before it discovers it in CSS — it is
         the font the LCP element is set in. -->
    <link rel="preload" href={jakartaWoff2} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces}></style>
  </head>
  <body>
    <slot />

    <style is:global define:vars={{ accent: theme.accent, cta: theme.cta }}>
      /* Every section in the design set --asc-accent / --asc-cta to the same
         two values. Hoisted to :root here — identical computed styles. */
      :root {
        --asc-accent: var(--accent);
        --asc-cta: var(--cta);

        /* Body copy. The design used clamp(15px, 1.05vw, 17px), but 1.05vw is
           only ~15px at 1440px wide, so body text never actually grew past its
           floor on a normal laptop. These scale for real between 1024–1600px.
           Tune body size and colour here — every paragraph reads from these. */
        --asc-body-size: clamp(17px, 1.25vw, 20px);
        --asc-body-size-sm: clamp(16px, 1.1vw, 18px);
        --asc-body-lh: 1.65;

        --asc-text-muted: #c3c2d2; /* body on the near-black ground */
        --asc-text-on-accent: #ece9fb; /* body on the purple ground */
        --asc-text-on-light: #3a384a; /* body on the light cards */
      }

      .asc-body {
        font-size: var(--asc-body-size);
        line-height: var(--asc-body-lh);
        text-wrap: pretty;
      }
      .asc-body-sm {
        font-size: var(--asc-body-size-sm);
        line-height: 1.6;
        text-wrap: pretty;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        background: #0f0f14;
      }
      * {
        box-sizing: border-box;
      }
      h1,
      h2,
      h3,
      p,
      span,
      div,
      a {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      }
      a {
        color: #f8f7fb;
        text-decoration: none;
      }

      /* --- style-hover= attributes from the design, as real CSS --- */
      .asc-navlink {
        color: #c7c7d2;
        font-size: 15px;
        font-weight: 500;
        letter-spacing: -0.01em;
        transition: color 0.18s ease;
      }
      .asc-navlink:hover {
        color: #f8f7fb;
      }

      .asc-cta-btn {
        background: var(--asc-cta, #ff6b4a);
        color: #17110e;
        transition:
          background 0.18s ease,
          transform 0.18s ease,
          box-shadow 0.18s ease;
      }
      .asc-cta-btn:hover {
        background: #ff7f62;
        color: #17110e;
        transform: translateY(-1px);
        box-shadow: 0 20px 48px -14px rgba(255, 107, 74, 0.85);
      }

      /* Approach card's text link */
      .asc-inline-link {
        color: #b8341a;
        transition: color 0.18s ease;
      }
      .asc-inline-link:hover {
        color: #d9401c;
      }

      /* Funnel service rows */
      .asc-funnel-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 11px 0;
        border-bottom: 1px solid rgba(248, 247, 251, 0.08);
        font-size: 15px;
        font-weight: 600;
        color: #e4e3ec;
        transition:
          color 0.18s ease,
          border-color 0.18s ease;
      }
      .asc-funnel-link:hover {
        color: #ff6b4a;
        border-color: rgba(255, 107, 74, 0.4);
      }

      /* Testimonial prev/next */
      .asc-quote-nav {
        flex: 0 0 auto;
        width: 46px;
        height: 46px;
        border-radius: 50%;
        border: 1px solid rgba(15, 15, 20, 0.2);
        background: transparent;
        color: #0f0f14;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition:
          background 0.25s ease,
          border-color 0.25s ease;
      }
      .asc-quote-nav:hover {
        background: rgba(110, 86, 207, 0.1);
        border-color: rgba(110, 86, 207, 0.5);
      }

      /* --- Brand lockup --------------------------------------------------- */
      .asc-brand {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        color: #f8f7fb;
      }
      .asc-brand:hover {
        color: #f8f7fb;
      }
      .asc-brand-mark {
        width: auto;
        height: 38px;
        flex: 0 0 auto;
      }

      /* Compact nav CTA — refined secondary glass pill so it complements the
         primary hero CTA instead of competing for attention. */
      .asc-nav-cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 0 20px;
        border-radius: 6px;
        background: rgba(248, 247, 251, 0.06);
        border: 1px solid rgba(248, 247, 251, 0.14);
        color: #f8f7fb;
        font-size: 14.5px;
        font-weight: 600;
        letter-spacing: -0.01em;
        white-space: nowrap;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        transition:
          background 0.18s ease,
          border-color 0.18s ease,
          color 0.18s ease,
          box-shadow 0.18s ease,
          transform 0.18s ease;
      }
      .asc-nav-cta:hover {
        background: var(--asc-cta, #ff6b4a);
        border-color: var(--asc-cta, #ff6b4a);
        color: #17110e;
        transform: translateY(-1px);
        box-shadow: 0 12px 28px -10px rgba(255, 107, 74, 0.7);
      }

      :focus-visible {
        outline: 2px solid var(--asc-cta, #ff6b4a);
        outline-offset: 3px;
      }

      /* ==================================================================
         RESPONSIVE
         The design shipped no breakpoints. Section styles are still inline
         (Pass 2 lifts them), so these rules target class hooks and use
         !important where an inline declaration would otherwise win.
         Two breakpoints: 900px stacks the side-by-side layouts, 640px is
         the phone pass.
         ================================================================== */

      /* Off by default; shown only on phones, where it replaces the ring. */
      .asc-work-mobile {
        display: none;
      }

      /* ---------- ≤ 900px: tablets, stack the two-column layouts ---------- */
      @media (max-width: 900px) {
        .asc-hero-grid,
        .asc-approach-card {
          grid-template-columns: minmax(0, 1fr) !important;
        }
        /* Logos wanted 3-up beside the picker; alone they can afford 4. */
        .asc-logo-grid {
          grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
        }
      }

      /* The phone menu exists only below 640px. */
      .asc-menu {
        display: none;
      }

      /* ---------- ≤ 640px: phones ---------- */
      @media (max-width: 640px) {
        /* ----- Above the fold: one message, one action -----
           Modelled on how the strongest agency sites handle a phone fold:
           a single-row navbar, a large LEFT-aligned headline, and the
           interactive picker directly under the CTA rather than pushed
           below a logo wall. Centred multi-line text on a narrow screen
           produces ragged edges on every line; left alignment reads as
           editorial and scans faster. */

        /* Navbar: logo + hamburger on one row, nothing else. */
        .asc-hero-nav {
          position: relative;
          flex-wrap: nowrap !important;
          min-height: 56px !important;
          gap: 0 !important;
        }
        .asc-hero-nav-right {
          display: none !important;
        }
        .asc-brand-mark {
          height: 30px;
        }
        .asc-menu {
          display: block;
        }
        .asc-menu-btn {
          list-style: none;
          display: flex;
          flex-direction: column;
          justify-content: center;
          gap: 6px;
          width: 44px;
          height: 44px;
          padding: 0 6px;
          cursor: pointer;
        }
        .asc-menu-btn::-webkit-details-marker {
          display: none;
        }
        .asc-menu-btn span {
          display: block;
          height: 2px;
          border-radius: 2px;
          background: #f8f7fb;
          transition: transform 0.2s ease, opacity 0.2s ease;
        }
        .asc-menu[open] .asc-menu-btn span:nth-child(1) {
          transform: translateY(8px) rotate(45deg);
        }
        .asc-menu[open] .asc-menu-btn span:nth-child(2) {
          opacity: 0;
        }
        .asc-menu[open] .asc-menu-btn span:nth-child(3) {
          transform: translateY(-8px) rotate(-45deg);
        }
        .asc-menu-panel {
          position: absolute;
          left: 0;
          right: 0;
          top: calc(100% + 12px);
          z-index: 30;
          display: flex;
          flex-direction: column;
          gap: 4px;
          padding: 10px;
          border: 1px solid rgba(248, 247, 251, 0.1);
          border-radius: 10px;
          background: #17161f;
          box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.9);
        }
        .asc-menu-link {
          padding: 14px 14px;
          border-radius: 6px;
          font-size: 17px;
          font-weight: 600;
          color: #f8f7fb;
        }
        .asc-menu-link:hover {
          background: rgba(248, 247, 251, 0.06);
        }
        .asc-menu-cta {
          justify-content: center;
          margin-top: 8px;
          min-height: 46px;
          background: var(--asc-cta, #ff6b4a) !important;
          color: #17110e !important;
          border-color: var(--asc-cta, #ff6b4a) !important;
          font-weight: 700;
        }
        .asc-menu-cta:hover {
          background: #ff7f62 !important;
          color: #17110e !important;
        }

        /* Copy column: left-aligned, and the headline earns its size. */
        .asc-hero-copy {
          align-items: flex-start !important;
          text-align: left !important;
          padding-top: 36px !important;
        }
        .asc-hero-copy h1 {
          max-width: none !important;
          /* 10vw = 37.5px at 375px: seven lines, and the CTA clears a 667px
             fold. 11vw made it eight lines and pushed the CTA under. */
          font-size: clamp(34px, 10vw, 42px) !important;
          line-height: 1.04 !important;
          letter-spacing: -0.035em !important;
        }
        .asc-hero-copy p {
          margin-top: 22px !important;
          font-size: 19px !important;
          line-height: 1.55 !important;
        }
        .asc-hero-copy > .asc-cta-btn {
          min-height: 56px !important;
          margin-top: 30px !important;
          padding: 0 34px !important;
          font-size: 16.5px !important;
        }

        /* Picker before logos: the thing to interact with sits right under
           the CTA; the proof wall follows. */
        .asc-hero-grid {
          margin-top: 48px !important;
        }
        .asc-hero-picker {
          order: -1;
        }
        .asc-hero-logos {
          margin-top: 8px;
        }

        .asc-logo-grid {
          grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
          grid-auto-rows: 64px !important;
        }
        .asc-picker-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        }





        /* Approach: pillar labels sit outside their nodes and clip on narrow
           screens — tuck them under instead. */
        .asc-pillar-label {
          font-size: 11.5px !important;
          max-width: 9ch !important;
        }



        /* Contact: two CTAs stack full-width. */
        .asc-contact-ctas > a {
          width: 100%;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }

      /* --- keyframes, verbatim from the design --- */
      @keyframes ascGlow {
        0%, 100% { opacity: 0.55; }
        50% { opacity: 0.9; }
      }
      @keyframes ascCaret {
        0%, 49% { opacity: 1; }
        50%, 100% { opacity: 0; }
      }
      @keyframes ascType {
        0% { max-width: 0; }
        55%, 100% { max-width: 100%; }
      }
      @keyframes ascRise {
        0% { opacity: 0; transform: translateY(10px); }
        18%, 92% { opacity: 1; transform: none; }
        100% { opacity: 1; transform: none; }
      }
      @keyframes ascRank {
        0%, 14% { transform: translateY(0); }
        30%, 46% { transform: translateY(-100%); }
        62%, 100% { transform: translateY(-200%); }
      }
      @keyframes ascGrow {
        0% { transform: scaleY(0.18); }
        100% { transform: scaleY(1); }
      }
      @keyframes ascDraw {
        0% { stroke-dashoffset: 320; }
        70%, 100% { stroke-dashoffset: 0; }
      }
      @keyframes ascSweep {
        0% { transform: translateX(-110%); }
        100% { transform: translateX(320%); }
      }
      @keyframes ascSway {
        from { transform: rotate(-3deg); }
        to { transform: rotate(3deg); }
      }
      @keyframes ascQuoteIn {
        from { opacity: 0; transform: translateY(14px) scale(0.985); }
        to { opacity: 1; transform: none; }
      }
      @keyframes ascFlicker {
        0% { opacity: 0.88; }
        50% { opacity: 1; }
        100% { opacity: 0.92; }
      }
      @keyframes ascLift {
        0% { width: 26%; }
        100% { width: 100%; }
      }
    </style>
  </body>
</html>
