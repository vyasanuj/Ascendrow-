---
import { theme } from '../data/site';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- favicon.ico carries 16 + 32px and answers the bare /favicon.ico request
         browsers make regardless of these tags. Built by scripts/build-favicon.mjs. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Pass 1 keeps the design's Google Fonts link so the render matches exactly.
         Pass 2 self-hosts these as subset woff2 to kill the render-blocking request. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />

    <style is:global define:vars={{ accent: theme.accent, cta: theme.cta }}>
      /* Every section in the design set --asc-accent / --asc-cta to the same
         two values. Hoisted to :root here — identical computed styles. */
      :root {
        --asc-accent: var(--accent);
        --asc-cta: var(--cta);

        /* Body copy. The design used clamp(15px, 1.05vw, 17px), but 1.05vw is
           only ~15px at 1440px wide, so body text never actually grew past its
           floor on a normal laptop. These scale for real between 1024–1600px.
           Tune body size and colour here — every paragraph reads from these. */
        --asc-body-size: clamp(17px, 1.25vw, 20px);
        --asc-body-size-sm: clamp(16px, 1.1vw, 18px);
        --asc-body-lh: 1.65;

        --asc-text-muted: #c3c2d2; /* body on the near-black ground */
        --asc-text-on-accent: #ece9fb; /* body on the purple ground */
        --asc-text-on-light: #3a384a; /* body on the light cards */
      }

      .asc-body {
        font-size: var(--asc-body-size);
        line-height: var(--asc-body-lh);
        text-wrap: pretty;
      }
      .asc-body-sm {
        font-size: var(--asc-body-size-sm);
        line-height: 1.6;
        text-wrap: pretty;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        background: #0f0f14;
      }
      * {
        box-sizing: border-box;
      }
      h1,
      h2,
      h3,
      p,
      span,
      div,
      a {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      }
      a {
        color: #f8f7fb;
        text-decoration: none;
      }

      /* --- style-hover= attributes from the design, as real CSS --- */
      .asc-navlink {
        color: #c7c7d2;
        transition: color 0.18s ease;
      }
      .asc-navlink:hover {
        color: #f8f7fb;
      }

      .asc-cta-btn {
        background: var(--asc-cta, #ff6b4a);
        color: #17110e;
        transition:
          background 0.18s ease,
          transform 0.18s ease;
      }
      .asc-cta-btn:hover {
        background: #ff7f62;
        color: #17110e;
        transform: translateY(-1px);
      }

      /* Approach card's text link */
      .asc-inline-link {
        color: #b8341a;
        transition: color 0.18s ease;
      }
      .asc-inline-link:hover {
        color: #d9401c;
      }

      /* Funnel service rows */
      .asc-funnel-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 11px 0;
        border-bottom: 1px solid rgba(248, 247, 251, 0.08);
        font-size: 15px;
        font-weight: 600;
        color: #e4e3ec;
        transition:
          color 0.18s ease,
          border-color 0.18s ease;
      }
      .asc-funnel-link:hover {
        color: #ff6b4a;
        border-color: rgba(255, 107, 74, 0.4);
      }

      /* Testimonial prev/next */
      .asc-quote-nav {
        flex: 0 0 auto;
        width: 46px;
        height: 46px;
        border-radius: 50%;
        border: 1px solid rgba(15, 15, 20, 0.2);
        background: transparent;
        color: #0f0f14;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition:
          background 0.25s ease,
          border-color 0.25s ease;
      }
      .asc-quote-nav:hover {
        background: rgba(110, 86, 207, 0.1);
        border-color: rgba(110, 86, 207, 0.5);
      }

      /* --- Brand lockup --------------------------------------------------- */
      .asc-brand {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        color: #f8f7fb;
      }
      .asc-brand:hover {
        color: #f8f7fb;
      }
      .asc-brand-mark {
        width: auto;
        height: 38px;
        flex: 0 0 auto;
      }

      /* Compact nav CTA — smaller than the hero button so the two don't
         compete for the same glance. */
      .asc-nav-cta {
        display: inline-flex;
        align-items: center;
        min-height: 48px;
        padding: 0 24px;
        border-radius: 4px;
        background: var(--asc-cta, #ff6b4a);
        color: #17110e;
        font-size: 15.5px;
        font-weight: 700;
        white-space: nowrap;
        transition:
          background 0.18s ease,
          transform 0.18s ease;
      }
      .asc-nav-cta:hover {
        background: #ff7f62;
        color: #17110e;
        transform: translateY(-1px);
      }

      :focus-visible {
        outline: 2px solid var(--asc-cta, #ff6b4a);
        outline-offset: 3px;
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }

      /* --- keyframes, verbatim from the design --- */
      @keyframes ascGlow {
        0%, 100% { opacity: 0.55; }
        50% { opacity: 0.9; }
      }
      @keyframes ascCaret {
        0%, 49% { opacity: 1; }
        50%, 100% { opacity: 0; }
      }
      @keyframes ascType {
        0% { max-width: 0; }
        55%, 100% { max-width: 100%; }
      }
      @keyframes ascRise {
        0% { opacity: 0; transform: translateY(10px); }
        18%, 92% { opacity: 1; transform: none; }
        100% { opacity: 1; transform: none; }
      }
      @keyframes ascRank {
        0%, 14% { transform: translateY(0); }
        30%, 46% { transform: translateY(-100%); }
        62%, 100% { transform: translateY(-200%); }
      }
      @keyframes ascGrow {
        0% { transform: scaleY(0.18); }
        100% { transform: scaleY(1); }
      }
      @keyframes ascDraw {
        0% { stroke-dashoffset: 320; }
        70%, 100% { stroke-dashoffset: 0; }
      }
      @keyframes ascSweep {
        0% { transform: translateX(-110%); }
        100% { transform: translateX(320%); }
      }
      @keyframes ascSway {
        from { transform: rotate(-3deg); }
        to { transform: rotate(3deg); }
      }
      @keyframes ascQuoteIn {
        from { opacity: 0; transform: translateY(14px) scale(0.985); }
        to { opacity: 1; transform: none; }
      }
      @keyframes ascFlicker {
        0% { opacity: 0.88; }
        50% { opacity: 1; }
        100% { opacity: 0.92; }
      }
      @keyframes ascLift {
        0% { width: 26%; }
        100% { width: 100%; }
      }
    </style>
  </body>
</html>
