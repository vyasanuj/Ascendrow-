---
import ApproachIsland from './Approach';
---

<section
  id="approach"
  style="background: #6E56CF; color: #F8F7FB; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; position: relative; overflow: hidden; padding: clamp(36px, 4.4vw, 64px) clamp(20px, 4vw, 56px) clamp(72px, 9vw, 132px);"
>
  <div style="position: relative; max-width: 1180px; margin: 0 auto;">
    <div style="text-align: center; max-width: 56ch; margin: 0 auto;">
      <h2
        style="margin: 0; font-size: clamp(26px, 3.2vw, 44px); font-weight: 800; letter-spacing: -0.035em; line-height: 1.08; text-wrap: balance;"
      >
        Every business needs three things to stand out. Most have one or two.
      </h2>
      <p
        class="asc-body"
        style="margin: clamp(16px, 2vw, 22px) auto 0; max-width: 54ch; color: var(--asc-text-on-accent);"
      >
        Tech that works, marketing that brings customers, and a team that runs both. We're three
        founders, one for each.
      </p>
    </div>

    <ApproachIsland client:visible />
  </div>
</section>
