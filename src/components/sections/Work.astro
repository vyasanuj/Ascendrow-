---
import { projects } from '../../data/content';

// A ring that carries the cards around a FIXED arc, with each card
// counter-rotated so it stays upright as it travels. The arc band never moves;
// the pictures slide along it.
//
// How the angles cancel. The ring rotates by θ. A card in slot A therefore
// inherits θ + A of rotation. Each card then gets:
//   · a static  -(1 - k)·A   to undo its slot tilt, and
//   · an animated -(1 - k)·θ  to undo the ring's spin.
// leaving a visible tilt of k·(θ + A).
//
//   TILT_FOLLOW = 1  cards welded to the ring — the design's original fanned
//                    arrangement, tilting to ±83° at the edges  (chosen)
//   TILT_FOLLOW = 0.42 reproduces the reference clip, which keeps roughly 40%
//                      of the tilt
//   TILT_FOLLOW = 0  cards perfectly upright the whole way round
const TILT_FOLLOW = 1;

// The ring must close or its gap swings into view. 360/13 = 27.69°, within
// 0.7° of the design's 27° spacing, so the arc sits exactly where it always
// has: -83, -55, -28, 0, 28, 55, 83 against the design's -81 … 81.
const SLOTS = 13;
const STEP = 360 / SLOTS;

// Seconds per revolution. Measured from the reference recording: the ring
// there turns about 1.2°/s, so a full turn takes ~290s and a card crosses the
// top of the arc roughly every 22 seconds.
const SPIN = 290;

const counterEnd = -(1 - TILT_FOLLOW) * 360;

const placed = Array.from({ length: SLOTS }, (_, i) => {
  const angle = (i - 6) * STEP;
  return {
    ...projects[i % projects.length],
    // Indices 0-6 are the 7 unique projects; 7-12 repeat them to close the ring.
    decorative: i >= projects.length,
    angle: angle.toFixed(3),
    deTilt: (-(1 - TILT_FOLLOW) * angle).toFixed(3),
  };
});
---

<section
  id="work"
  style="margin-top: -2px; background: linear-gradient(180deg, #6E56CF 0%, #5C48BC 14%, #40347F 34%, #241F44 46%, #0F0F14 56%, #0F0F14 100%); color: #F8F7FB; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; position: relative; overflow: hidden; padding: clamp(30px, 3.2vw, 52px) clamp(20px, 4vw, 56px) clamp(56px, 6.5vw, 96px);"
>
  <!-- Phones get a swipeable strip instead of the ring: at the ring's minimum
       radius (474px) and card width (192px), a 375px viewport would show one
       card and clip the rest. Hidden above 640px; the ring is hidden below. -->
  <div class="asc-work-mobile" aria-label="Selected work">
    {
      projects.map((p) => (
        <img
          src={p.img}
          alt={p.alt}
          width="820"
          height="512"
          loading="lazy"
          decoding="async"
        />
      ))
    }
  </div>

  <div class="asc-work-stage" style="position: relative; max-width: 1320px; margin: 0 auto; min-height: clamp(560px, 58vw, 800px);">
    <!--
      transform-origin is load-bearing. Each card is placed with
      `rotate(A) translateY(-R)`, and a transform rotates about the element's
      own centre — so the cards orbit a point half a card-height BELOW this
      hub, not the hub itself. Leave this hub spinning about its own 0x0 point
      and the two axes disagree: the arc keeps its radius but its centre swings
      around a ~61px circle, which reads as the whole arc wandering.

      So pin the hub's axis to where the cards actually orbit:
        half card height = width / (16/10) / 2 + padding
                         = clamp(192px, 21vw, 405px) / 3.2 + clamp(4px, .6vw, 8px)
    -->
    <div
      class="asc-work-wheel"
      style="position: absolute; left: 50%; top: calc(clamp(474px, 51vw, 860px) + 40px); width: 0; height: 0; transform-origin: 0 calc(clamp(192px, 21vw, 405px) / 3.2 + clamp(4px, .6vw, 8px));"
    >
      {
        placed.map((p) => (
          <div
            style={`position: absolute; left: 0; top: 0; width: clamp(192px, 21vw, 405px); margin-left: calc(clamp(192px, 21vw, 405px) / -2); transform: rotate(${p.angle}deg) translateY(clamp(-860px, -51vw, -474px));`}
          >
            <div style={`transform: rotate(${p.deTilt}deg);`}>
              <div
                class={TILT_FOLLOW < 1 ? 'asc-work-card' : undefined}
                style="border-radius: 9px; padding: clamp(4px, .6vw, 8px); background: linear-gradient(160deg, #2E2C39, #191821); box-shadow: 0 34px 64px -34px rgba(0,0,0,.95);"
              >
                <div
                  role={p.decorative ? undefined : 'img'}
                  aria-label={p.decorative ? undefined : p.alt}
                  aria-hidden={p.decorative ? 'true' : undefined}
                  style={`border-radius: 4px; aspect-ratio: 16 / 10; background-color: #0F0F14; background-image: url("${p.img}"); background-size: contain; background-position: center; background-repeat: no-repeat;`}
                />
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div
      class="asc-work-copy"
      style="position: absolute; left: 50%; top: 68%; transform: translate(-50%, -50%); width: min(680px, 100%); text-align: center;"
    >
      <div
        style="position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 150%; height: 190%; background: radial-gradient(closest-side, rgba(15,15,20,.82) 46%, rgba(15,15,20,.5) 70%, rgba(15,15,20,0)); pointer-events: none;"
      >
      </div>
      <div style="position: relative;">
        <h2
          style="margin: 14px 0 0; font-size: clamp(28px, 3.6vw, 50px); font-weight: 800; letter-spacing: -0.035em; line-height: 1.06; text-wrap: balance;"
        >
          Here's the work. Now let's talk about yours.
        </h2>
        <p
          class="asc-body"
          style="margin: clamp(14px, 1.8vw, 20px) auto 0; max-width: 50ch; color: #D6D4E4;"
        >
          Websites, campaigns and brands we've built for businesses across industries. Tell us about
          your project and we'll show you what we'd do.
        </p>
        <a
          href="#contact"
          class="asc-cta-btn"
          style="display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 52px; margin-top: clamp(20px, 2.4vw, 30px); padding: 0 30px; border-radius: 4px; font-size: 15.5px; font-weight: 700; white-space: nowrap; box-shadow: 0 18px 44px -18px rgba(255,107,74,.75);"
        >
          Book a call
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            style="flex: 0 0 auto;"
            aria-hidden="true"
          >
            <path
              d="M5 12h13M12.5 6l6 6-6 6"
              stroke="#17110E"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style is:global define:vars={{ ascSpin: `${SPIN}s`, ascCounterEnd: `${counterEnd}deg` }}>
  /* Ring and cards share one duration, so the counter-rotation stays exactly
     in step with the spin and the cards never wobble. `linear` on both — any
     easing would desynchronise them mid-cycle. */
  .asc-work-wheel {
    animation: ascWheel var(--ascSpin) linear infinite;
    will-change: transform;
  }

  .asc-work-card {
    animation: ascCounterSpin var(--ascSpin) linear infinite;
    will-change: transform;
  }

  @keyframes ascWheel {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  /* Equal and opposite to ascWheel, scaled by how much tilt should remain. */
  @keyframes ascCounterSpin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(var(--ascCounterEnd));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .asc-work-wheel,
    .asc-work-card {
      animation: none !important;
    }
  }
</style>
