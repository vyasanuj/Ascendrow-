---
// Static. The CTAs are anchors today; they become a real form when the
// contact action lands.
---

<section
  id="contact"
  style="background: #0F0F14; color: #F8F7FB; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; position: relative; overflow: hidden; padding: clamp(56px, 7vw, 104px) clamp(20px, 4vw, 56px) clamp(64px, 8vw, 116px);"
>
  <div
    style="position: relative; max-width: 1080px; margin: 0 auto; border: 1px solid rgba(201,194,236,.18); border-radius: 14px; background: radial-gradient(120% 130% at 50% 0%, rgba(110,86,207,.34) 0%, rgba(110,86,207,.1) 44%, rgba(15,15,20,.96) 82%), linear-gradient(180deg, #1B1A24, #131219); box-shadow: 0 50px 110px -55px rgba(110,86,207,.65); padding: clamp(36px, 5vw, 78px) clamp(22px, 3.4vw, 60px); text-align: center; overflow: hidden;"
  >
    <div
      style="position: absolute; left: 50%; top: -40%; transform: translateX(-50%); width: min(620px, 90%); height: 420px; border-radius: 50%; background: radial-gradient(circle, rgba(255,107,74,.14), rgba(255,107,74,0) 68%); pointer-events: none;"
    >
    </div>

    <div style="position: relative; max-width: 40ch; margin: 0 auto;">
      <div
        style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: #C9C2EC;"
      >
        Start here
      </div>
      <h2
        style="margin: 16px 0 0; font-size: clamp(28px, 3.6vw, 52px); font-weight: 800; letter-spacing: -0.04em; line-height: 1.02; text-wrap: balance;"
      >
        Let's build the growth system your market can't ignore.
      </h2>
      <p
        class="asc-body"
        style="margin: clamp(16px, 2vw, 24px) auto 0; max-width: 52ch; color: var(--asc-text-muted);"
      >
        Tell us where buyers are slipping away — visibility, attention, trust or conversion — and
        we'll map the fix as one plan across paid, organic, brand and product.
      </p>

      <div
        style="display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: clamp(26px, 3.2vw, 38px);"
      >
        <a
          href="#contact"
          class="asc-cta-btn"
          style="display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 54px; padding: 0 30px; border-radius: 4px; font-size: 16px; font-weight: 700; white-space: nowrap; box-shadow: 0 18px 44px -18px rgba(255,107,74,.75);"
        >
          Build Your Growth System
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            style="flex: 0 0 auto;"
            aria-hidden="true"
          >
            <path
              d="M5 12h13M12.5 6l6 6-6 6"
              stroke="#17110E"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
        <a href="#approach" class="asc-ghost-btn">See How We Work</a>
      </div>

      <div
        style="display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 10px 16px; margin-top: clamp(26px, 3.2vw, 38px); font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: #8A8A9A;"
      >
        <span>Paid Media</span><span style="color: rgba(110,86,207,.8);">•</span>
        <span>Organic Growth</span><span style="color: rgba(110,86,207,.8);">•</span>
        <span>Brand</span><span style="color: rgba(110,86,207,.8);">•</span>
        <span>Product Design</span>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .asc-ghost-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 54px;
    padding: 0 26px;
    border-radius: 4px;
    border: 1px solid rgba(248, 247, 251, 0.2);
    color: #f8f7fb;
    font-size: 16px;
    font-weight: 600;
    white-space: nowrap;
    transition:
      border-color 0.18s ease,
      background 0.18s ease;
  }
  .asc-ghost-btn:hover {
    border-color: rgba(201, 194, 236, 0.55);
    background: rgba(110, 86, 207, 0.14);
    color: #f8f7fb;
  }
</style>
