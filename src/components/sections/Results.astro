---
// Results section displaying a glimpse of the case study
const caseStudies = [
  {
    id: "rotimatic",
    brand: "Rotimatic",
    logo: "/brands/Rotimatic_Logo_.png",
    type: "D2C",
    title: 'Transforming the sales pipeline for a <span style="color: var(--card-accent);">premium brand.</span>',
    description: "By integrating directly as an extension of the team, we completely transformed the support and sales pipeline for Rotimatic, driving massive ROI across global markets.",
    link: "/case-studies/rotimatic",
    stats: [
      { label: "Revenue Generated", value: "$165K" },
      { label: "Pipeline Managed", value: "$450K" }
    ],
    image: "/mockups/Rotimatic-img.webp",
    accent: "#F97316",
    accentRgb: "249, 115, 22"
  },
  {
    id: "ehack-academy",
    brand: "eHack Academy",
    logo: "/brands/white-academy.png",
    type: "Tech & Performance Marketing",
    title: 'Building a <span style="color: var(--card-accent);">cybersecurity funnel.</span>',
    description: "From zero to ₹22.5L+ in monthly sales by building a complete digital acquisition system.",
    link: "/case-studies/white-academy",
    stats: [
      { label: "Monthly Sales", value: "₹22.5L+" },
      { label: "Enrollments", value: "15+" }
    ],
    image: "/mockups/diploma-ss.png",
    secondaryImage: "/mockups/job-ready-promote.png",
    accent: "#3B82F6",
    accentRgb: "59, 130, 246"
  },
  {
    id: "digital-marketing-program",
    brand: "eHack Academy",
    logo: "/brands/white-academy.png",
    type: "Tech & Performance Marketing",
    title: 'Selling a ₹1 Lakh <span style="color: var(--card-accent);">premium program.</span>',
    description: "How we launched a premium digital marketing program and generated ₹3L+ in a highly saturated market.",
    link: "/case-studies/digital-marketing",
    stats: [
      { label: "Confirmed Sales", value: "₹3L+" },
      { label: "Conv. Rate", value: "~70%" }
    ],
    image: "/mockups/digi-marketing-ui.png",
    slideshowImages: [
      "/mockups/digi-marketing-ui.png",
      "/mockups/digi-marketing-ui-1.png"
    ],
    accent: "#EC4899",
    accentRgb: "236, 72, 153"
  }
];
---

<section id="results" style="background-color: #6E56CF; position: relative; overflow: clip; padding: clamp(32px, 6vw, 80px) clamp(20px, 4vw, 56px) clamp(48px, 8vw, 120px); color: #F8F7FB; font-family: 'Plus Jakarta Sans', system-ui, sans-serif;">
  <!-- Matte Noisy Texture -->
  <div style="position: absolute; inset: 0; opacity: 0.3; mix-blend-mode: overlay; pointer-events: none; background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.8%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E');"></div>

  <div style="position: relative; max-width: 1400px; margin: 0 auto; z-index: 2;">
    
    <!-- Top Center Headline -->
    <div style="text-align: center; margin-bottom: clamp(32px, 5vw, 64px);">
      <h2 style="font-size: clamp(36px, 4vw, 56px); font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; margin: 0 auto; max-width: 25ch; text-wrap: balance; text-align: center; color: #FFF;">
        Real impact that builds <span style="color: #FF6B4A;">lasting partnerships.</span>
      </h2>
    </div>

    <!-- The Cards Container -->
    <div class="cards-container" style="position: relative; padding-bottom: 1px;">
      {caseStudies.map((study, index) => (
        <Fragment>
          <div class="asc-case-wrapper" style={`position: sticky; top: clamp(80px, 15vh, 120px); z-index: ${index + 1};`} data-index={index}>
            <a href={study.link} class="asc-case-card" style={`--card-accent: ${study.accent}; --card-accent-rgb: ${study.accentRgb}; display: block; background: #0A0A0A; border: 1px solid rgba(255, 255, 255, 0.1); box-shadow: 0 24px 48px rgba(0,0,0,0.4); border-radius: 24px; text-decoration: none; position: relative; overflow: hidden;`}>
            <div class="card-shadow-overlay" style="position: absolute; inset: 0; background: #000; opacity: 0; pointer-events: none; z-index: 10; transition: opacity 0.1s linear;"></div>
            <!-- CSS Grid Layout -->
            <div class="card-grid">
              
              <!-- Column 1 (Left): Information & Badges -->
              <div style="padding: clamp(24px, 3.5vw, 48px); display: flex; flex-direction: column; justify-content: flex-start;">
                
                <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 16px; margin-bottom: 24px;">
                  <img src={study.logo} alt={`${study.brand} Logo`} style="height: 28px; width: auto; object-fit: contain;" />
                  <span style="display: inline-flex; align-items: center; background: rgba(var(--card-accent-rgb), 0.1); border: 1px solid rgba(var(--card-accent-rgb), 0.3); padding: 6px 16px; border-radius: 99px; font-size: 14px; font-weight: 700; color: var(--card-accent); letter-spacing: 0.05em;">{study.type}</span>
                </div>

                <h3 style="font-size: clamp(24px, 2.5vw, 36px); font-weight: 800; line-height: 1.2; letter-spacing: -0.02em; color: #FFF; margin: 0 0 16px 0;" set:html={study.title}></h3>
                <p style="font-size: 18px; line-height: 1.6; color: rgba(255, 255, 255, 0.95); margin: 0 0 24px 0;">{study.description}</p>
                
                <div style="display: inline-flex; align-items: center; gap: 16px; font-size: 16px; font-weight: 700; color: var(--card-accent); margin-top: auto;">
                  <span>Read full case study</span>
                  <div style="width: 40px; height: 40px; border-radius: 50%; border: 1px solid rgba(var(--card-accent-rgb), 0.4); display: flex; align-items: center; justify-content: center; color: var(--card-accent);">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                      <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                </div>
              </div>

              <!-- Column 2 (Center): Stats -->
              <div class="impact-stats-col" style="padding: clamp(24px, 3.5vw, 48px); display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; gap: 40px;">
                {study.stats.map((stat) => (
                  <div style="display: flex; flex-direction: column; align-items: center;">
                    <div style="font-family: 'JetBrains Mono', monospace; font-size: 13px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--card-accent); font-weight: 700; margin-bottom: 8px;">{stat.label}</div>
                    <div style="font-size: clamp(40px, 4.5vw, 64px); font-weight: 800; line-height: 1; color: #FFF;">{stat.value}</div>
                  </div>
                ))}
              </div>

              <!-- Column 3 (Right): Image Area with Matte Noisy Texture -->
              <div class="case-study-img-col" style="position: relative; display: flex; align-items: center; justify-content: center; padding: clamp(24px, 3.5vw, 48px); background: linear-gradient(145deg, rgba(var(--card-accent-rgb), 0.15), rgba(var(--card-accent-rgb), 0.02)); overflow: hidden; border-top-right-radius: 24px; border-bottom-right-radius: 24px;">
                <!-- Noisy Texture Overlay -->
                <div style="position: absolute; inset: 0; opacity: 0.3; mix-blend-mode: overlay; pointer-events: none; background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.8%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E');"></div>
                
                {study.slideshowImages && study.slideshowImages.length > 1 ? (
                  <div style="position: relative; width: 100%; aspect-ratio: 16/10; display: flex; align-items: center; justify-content: center;">
                    <!-- Base image (always visible) -->
                    <img src={study.slideshowImages[0]} alt={`${study.brand} Product Mockup 1`} style="position: absolute; width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 20px 40px rgba(0,0,0,0.3));" />
                    <!-- Fading image (crossfades over base image) -->
                    <img src={study.slideshowImages[1]} alt={`${study.brand} Product Mockup 2`} style="position: absolute; width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 20px 40px rgba(0,0,0,0.3)); animation: fade-slideshow 6s infinite ease-in-out;" />
                  </div>
                ) : study.secondaryImage ? (
                  <div style="position: relative; width: 100%; aspect-ratio: 16/10; display: flex; align-items: center; justify-content: center;">
                    <div style="display: grid; grid-template-columns: 1fr; grid-template-rows: 1fr; width: 100%; max-width: 420px; align-items: center; justify-items: center;">
                      <!-- Secondary (Background) Image -->
                      <img src={study.secondaryImage} alt={`${study.brand} Secondary Product Mockup`} style="grid-column: 1; grid-row: 1; width: 95%; height: auto; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.2); opacity: 0.6; transform: translate(12%, -12%) scale(0.9); z-index: 1; filter: blur(1px);" />
                      <!-- Primary (Foreground) Image -->
                      <img src={study.image} alt={`${study.brand} Product Mockup`} style="grid-column: 1; grid-row: 1; width: 100%; height: auto; border-radius: 12px; box-shadow: -10px 20px 40px rgba(0,0,0,0.4); transform: translate(-8%, 8%); z-index: 2;" />
                    </div>
                  </div>
                ) : (
                  <div style="position: relative; width: 100%; aspect-ratio: 16/10; display: flex; align-items: center; justify-content: center;">
                    <img src={study.image} alt={`${study.brand} Product Mockup`} style="position: absolute; width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 20px 40px rgba(0,0,0,0.3));" />
                  </div>
                )}
              </div>

            </div>
          </a>
        </div>
        <div class="case-study-spacer" style={`height: ${index !== caseStudies.length - 1 ? '25vh' : '15vh'};`}></div>
        </Fragment>
      ))}
    </div>

    <!-- View All Button (Outside container so it doesn't overlap the sticky cards) -->
    <div style="text-align: center; margin-top: clamp(24px, 4vw, 48px); position: relative; z-index: 10;">
      <a href="/case-studies" class="results-cta-btn">
        <span>View all case studies</span>
        <div class="results-cta-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
            <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </a>
    </div>

  </div>
</section>

<script>
  // Add scroll event listener to animate cards
  function initCardAnimation() {
    const wrappers = Array.from(document.querySelectorAll('.asc-case-wrapper'));
    if (!wrappers.length) return;

    // Cache elements so we don't query the DOM inside the scroll loop
    const cards = wrappers.map(w => w.querySelector('.asc-case-card') as HTMLElement);
    
    let ticking = false;

    const updateCards = () => {
      // 1. Check Mobile Fast-Path
      if (window.innerWidth <= 768) {
        cards.forEach(card => {
          if (card) {
            const overlay = card.querySelector('.card-shadow-overlay') as HTMLElement;
            if (overlay) overlay.style.opacity = '0';
          }
        });
        ticking = false;
        return;
      }

      // 2. BATCH ALL READS (Prevent layout thrashing)
      const tops = wrappers.map(w => w.getBoundingClientRect().top);

      // 3. BATCH ALL WRITES
      wrappers.forEach((_, index) => {
        // We only animate fading out for cards that have a card after them
        if (index === wrappers.length - 1) return;
        
        const cardElement = cards[index];
        if (!cardElement) return;

        const currentTop = tops[index];
        const nextTop = tops[index + 1];
        
        // Calculate distance between this card's top and next card's top
        const distance = nextTop - currentTop;
        const fadeStartDistance = 80;
        
        if (distance < fadeStartDistance) {
          // Progress from 0 (just started fading) to 1 (fully overlapped)
          let progress = 1 - (distance / fadeStartDistance);
          progress = Math.max(0, Math.min(1, progress));
          
          const overlay = cardElement.querySelector('.card-shadow-overlay') as HTMLElement;
          if (overlay) {
             overlay.style.opacity = (progress * 0.85).toString();
          }
        } else {
          // Reset styles if scrolling back up
          const overlay = cardElement.querySelector('.card-shadow-overlay') as HTMLElement;
          if (overlay) overlay.style.opacity = '0';
        }
      });

      ticking = false;
    };

    const onScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(updateCards);
        ticking = true;
      }
    };

    // Clean up old listeners for HMR
    if ((window as any)._ascScrollListener) {
      window.removeEventListener('scroll', (window as any)._ascScrollListener);
      window.removeEventListener('resize', (window as any)._ascScrollListener);
    }
    (window as any)._ascScrollListener = onScroll;

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    
    // Trigger once on load
    updateCards();
  }

  // Run on initial load and when astro swaps pages
  document.addEventListener('DOMContentLoaded', initCardAnimation);
  document.addEventListener('astro:page-load', initCardAnimation);
</script>

<style is:global>
  /* View All CTA Button */
  .results-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    min-height: 64px;
    padding: 0 12px 0 32px;
    border-radius: 99px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.1);
    color: #FFF;
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.05), 0 10px 30px rgba(0,0,0,0.15);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .results-cta-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #FF6B4A;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFF;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .results-cta-btn:hover {
    background: rgba(255,255,255,0.08);
    border-color: rgba(255,255,255,0.25);
    transform: translateY(-2px);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.1), 0 20px 40px rgba(0,0,0,0.25);
  }

  .results-cta-btn:hover .results-cta-icon {
    transform: translateX(4px);
  }

  /* Responsive subtle line separation for the center column */
  .impact-stats-col {
    border-top: 1px solid rgba(255,255,255,0.08);
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  
  .card-grid {
    display: grid;
    grid-template-columns: 1fr;
    align-items: stretch;
  }
  
  @media (min-width: 768px) {
    .card-grid {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    }
  }

  @media (min-width: 1024px) {
    .asc-case-card {
      height: 440px !important;
    }
    .card-grid {
      /* Left: 1.1fr, Middle: 0.7fr, Right (Image): 1.4fr */
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.7fr) minmax(0, 1.4fr);
      height: 100%;
    }
    .impact-stats-col {
      border-top: none;
      border-bottom: none;
      border-left: 1px solid rgba(255,255,255,0.08);
      border-right: 1px solid rgba(255,255,255,0.08);
    }
  }
  
  /* Media query for mobile adjustments in stacking */
  @media (max-width: 768px) {
    .asc-case-wrapper {
      /* Disable sticky stacking on mobile to avoid cutting off tall cards */
      position: relative !important;
      top: auto !important;
      margin-bottom: 24px !important;
      z-index: 1 !important;
    }
    .cards-container {
      padding-bottom: 0 !important;
    }
    .case-study-spacer {
      display: none !important;
    }
    /* Reset radius for column 3 on small screens */
    .case-study-img-col {
      border-top-right-radius: 0 !important;
      border-bottom-right-radius: 24px !important;
      border-bottom-left-radius: 24px !important;
    }
  }
</style>

<style is:global>
  @keyframes fade-slideshow {
    0%, 45% { opacity: 1; }
    50%, 95% { opacity: 0; }
    100% { opacity: 1; }
  }
</style>
