---
// Results section displaying a glimpse of the case study
const caseStudies = [
  {
    id: "rotimatic",
    brand: "Rotimatic",
    logo: "/brands/Rotimatic_Logo_.png",
    type: "D2C",
    title: 'Transforming the sales pipeline for a <span style="color: #FF6B4A;">premium brand.</span>',
    description: "By integrating directly as an extension of the team, we completely transformed the support and sales pipeline for Rotimatic, driving massive ROI across global markets.",
    link: "/case-studies/rotimatic",
    stats: [
      { label: "Revenue Generated", value: "$165K" },
      { label: "Pipeline Managed", value: "$450K" }
    ],
    image: "/mockups/Rotimatic-img.webp"
  },
  {
    id: "ehack-academy",
    brand: "eHack Academy",
    logo: "/brands/white-academy.png",
    type: "Tech & Performance Marketing",
    title: 'Building a <span style="color: #FF6B4A;">cybersecurity funnel.</span>',
    description: "From zero to ₹22.5L+ in monthly sales by building a complete digital acquisition system.",
    link: "/case-studies/white-academy",
    stats: [
      { label: "Monthly Sales", value: "₹22.5L+" },
      { label: "Enrollments", value: "15+" }
    ],
    image: "/mockups/diploma-ss.png",
    secondaryImage: "/mockups/job-ready-promote.png"
  },
  {
    id: "digital-marketing-program",
    brand: "eHack Academy",
    logo: "/brands/white-academy.png",
    type: "Tech & Performance Marketing",
    title: 'Selling a ₹1 Lakh <span style="color: #FF6B4A;">premium program.</span>',
    description: "How we launched a premium digital marketing program and generated ₹3L+ in a highly saturated market.",
    link: "/case-studies/digital-marketing",
    stats: [
      { label: "Confirmed Sales", value: "₹3L+" },
      { label: "Conv. Rate", value: "~70%" }
    ],
    image: "/mockups/digi-marketing-ui.png",
    slideshowImages: [
      "/mockups/digi-marketing-ui.png",
      "/mockups/digi-marketing-ui-1.png"
    ]
  }
];
---

<section id="results" style="background-color: #6E56CF; position: relative; overflow: clip; padding: clamp(32px, 6vw, 80px) clamp(20px, 4vw, 56px) clamp(48px, 8vw, 120px); color: #F8F7FB; font-family: 'Plus Jakarta Sans', system-ui, sans-serif;">
  <!-- Matte Noisy Texture -->
  <div style="position: absolute; inset: 0; opacity: 0.3; mix-blend-mode: overlay; pointer-events: none; background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.8%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E');"></div>

  <div style="position: relative; max-width: 1400px; margin: 0 auto; z-index: 2;">
    
    <!-- Top Center Headline -->
    <div style="text-align: center; margin-bottom: clamp(32px, 5vw, 64px);">
      <h2 style="font-size: clamp(36px, 4vw, 56px); font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; margin: 0 auto; max-width: 25ch; text-wrap: balance; text-align: center; color: #FFF;">
        Real impact that builds <span style="color: #FF6B4A;">lasting partnerships.</span>
      </h2>
    </div>

    <!-- The Cards Container -->
    <div class="cards-container" style="position: relative; padding-bottom: 1px;">
      {caseStudies.map((study, index) => (
        <div class="case-study-wrapper" style={`position: sticky; top: clamp(80px, 15vh, 120px); margin-bottom: ${index !== caseStudies.length - 1 ? '25vh' : '10vh'}; z-index: ${index + 1};`} data-index={index}>
          <a href={study.link} class="case-study-card" style="display: block; min-height: 480px; height: 100%; background: linear-gradient(135deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02)); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 24px; text-decoration: none; position: relative; overflow: hidden; transform-origin: top center; will-change: transform, opacity, filter;">
            
            <!-- CSS Grid Layout -->
            <div class="card-grid">
              
              <!-- Column 1 (Left): Information & Badges -->
              <div style="padding: clamp(32px, 4vw, 64px); display: flex; flex-direction: column; justify-content: flex-start;">
                
                <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 24px;">
                  <span style="display: inline-flex; align-items: center; gap: 10px; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); padding: 6px 16px 6px 6px; border-radius: 99px; font-size: 14px; font-weight: 700; color: #FFF; letter-spacing: 0.05em;">
                    <span style="background: #FFF; width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                      <img src={study.logo} alt={`${study.brand} Logo`} style="height: 14px; width: auto; object-fit: contain;" />
                    </span>
                    {study.brand}
                  </span>
                  <span style="display: inline-flex; align-items: center; background: rgba(255, 107, 74, 0.1); border: 1px solid rgba(255, 107, 74, 0.3); padding: 6px 16px; border-radius: 99px; font-size: 14px; font-weight: 700; color: #FF6B4A; letter-spacing: 0.05em;">{study.type}</span>
                </div>

                <h3 style="font-size: clamp(28px, 3vw, 40px); font-weight: 800; line-height: 1.2; letter-spacing: -0.02em; color: #FFF; margin: 0 0 16px 0;" set:html={study.title}></h3>
                <p style="font-size: 18px; line-height: 1.6; color: rgba(255,255,255,0.85); margin: 0 0 32px 0;">{study.description}</p>
                
                <div style="display: inline-flex; align-items: center; gap: 16px; font-size: 16px; font-weight: 700; color: #FF6B4A; margin-top: auto;">
                  <span>Read full case study</span>
                  <div style="width: 40px; height: 40px; border-radius: 50%; border: 1px solid rgba(255, 107, 74, 0.4); display: flex; align-items: center; justify-content: center; color: #FF6B4A;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                      <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                </div>
              </div>

              <!-- Column 2 (Center): Stats -->
              <div class="impact-stats-col" style="padding: clamp(32px, 4vw, 64px); display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; gap: 56px;">
                {study.stats.map((stat) => (
                  <div style="display: flex; flex-direction: column; align-items: center;">
                    <div style="font-family: 'JetBrains Mono', monospace; font-size: 13px; text-transform: uppercase; letter-spacing: 0.12em; color: #FF6B4A; font-weight: 700; margin-bottom: 8px;">{stat.label}</div>
                    <div style="font-size: clamp(48px, 5vw, 72px); font-weight: 800; line-height: 1; color: #FFF;">{stat.value}</div>
                  </div>
                ))}
              </div>

              <!-- Column 3 (Right): Image Area with Matte Noisy Texture -->
              <div class="case-study-img-col" style="position: relative; display: flex; align-items: center; justify-content: center; padding: clamp(32px, 4vw, 64px); background-color: #6E56CF; overflow: hidden; border-top-right-radius: 24px; border-bottom-right-radius: 24px;">
                <!-- Noisy Texture Overlay -->
                <div style="position: absolute; inset: 0; opacity: 0.3; mix-blend-mode: overlay; pointer-events: none; background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.8%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E');"></div>
                
                {study.slideshowImages && study.slideshowImages.length > 1 ? (
                  <div style="position: relative; width: 100%; aspect-ratio: 1/1; display: flex; align-items: center; justify-content: center;">
                    <!-- Base image (always visible) -->
                    <img src={study.slideshowImages[0]} alt={`${study.brand} Product Mockup 1`} style="position: absolute; width: 110%; height: 110%; object-fit: contain; filter: drop-shadow(0 20px 40px rgba(0,0,0,0.3));" />
                    <!-- Fading image (crossfades over base image) -->
                    <img src={study.slideshowImages[1]} alt={`${study.brand} Product Mockup 2`} style="position: absolute; width: 110%; height: 110%; object-fit: contain; filter: drop-shadow(0 20px 40px rgba(0,0,0,0.3)); animation: fade-slideshow 6s infinite ease-in-out;" />
                  </div>
                ) : study.secondaryImage ? (
                  <div style="display: grid; grid-template-columns: 1fr; grid-template-rows: 1fr; width: 100%; max-width: 420px; align-items: center; justify-items: center;">
                    <!-- Secondary (Background) Image -->
                    <img src={study.secondaryImage} alt={`${study.brand} Secondary Product Mockup`} style="grid-column: 1; grid-row: 1; width: 95%; height: auto; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.2); opacity: 0.6; transform: translate(12%, -12%) scale(0.9); z-index: 1; filter: blur(1px);" />
                    <!-- Primary (Foreground) Image -->
                    <img src={study.image} alt={`${study.brand} Product Mockup`} style="grid-column: 1; grid-row: 1; width: 100%; height: auto; border-radius: 12px; box-shadow: -10px 20px 40px rgba(0,0,0,0.4); transform: translate(-8%, 8%); z-index: 2;" />
                  </div>
                ) : (
                  <div style="position: relative; width: 100%; aspect-ratio: 1/1; display: flex; align-items: center; justify-content: center;">
                    <img src={study.image} alt={`${study.brand} Product Mockup`} style="position: absolute; width: 110%; height: 110%; object-fit: contain; filter: drop-shadow(0 20px 40px rgba(0,0,0,0.3));" />
                  </div>
                )}
              </div>

            </div>
          </a>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  // Add scroll event listener to animate cards
  function initCardAnimation() {
    const wrappers = document.querySelectorAll('.case-study-wrapper');
    if (!wrappers.length) return;

    const onScroll = () => {
      const windowHeight = window.innerHeight;

      wrappers.forEach((wrapper, index) => {
        // We only animate fading out for cards that have a card after them
        if (index === wrappers.length - 1) return;
        
        const nextWrapper = wrappers[index + 1];
        if (!nextWrapper) return;

        const wrapperRect = wrapper.getBoundingClientRect();
        const nextRect = nextWrapper.getBoundingClientRect();
        const cardElement = wrapper.querySelector('.case-study-card') as HTMLElement;

        if (!cardElement) return;

        // Disable animation on mobile where cards are not sticky
        if (window.innerWidth <= 768) {
          cardElement.style.opacity = '1';
          cardElement.style.transform = `scale(1)`;
          cardElement.style.filter = `blur(0px)`;
          return;
        }

        // Calculate distance between this card's top and next card's top
        const distance = nextRect.top - wrapperRect.top;
        
        // Only start fading when the next card is extremely close (last 80px of scroll)
        // This ensures the next card is practically in place before the current one changes
        const fadeStartDistance = 80;
        
        if (distance < fadeStartDistance) {
          // Progress from 0 (just started fading) to 1 (fully overlapped)
          let progress = 1 - (distance / fadeStartDistance);
          progress = Math.max(0, Math.min(1, progress));
          
          const opacity = 1 - progress;
          const scale = 1 - (0.08 * progress); // Scale down slightly to 0.92
          const blur = progress * 10; // Blur up to 10px

          cardElement.style.opacity = opacity.toString();
          cardElement.style.transform = `scale(${scale})`;
          cardElement.style.filter = `blur(${blur}px)`;
        } else {
          // Reset styles if scrolling back up
          cardElement.style.opacity = '1';
          cardElement.style.transform = `scale(1)`;
          cardElement.style.filter = `blur(0px)`;
        }
      });
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    // Trigger once on load
    onScroll();
  }

  // Run on initial load and when astro swaps pages
  document.addEventListener('DOMContentLoaded', initCardAnimation);
  document.addEventListener('astro:page-load', initCardAnimation);
</script>

<style is:global>
  /* Responsive subtle line separation for the center column */
  .impact-stats-col {
    border-top: 1px solid rgba(255,255,255,0.08);
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  
  .card-grid {
    display: grid;
    grid-template-columns: 1fr;
    align-items: stretch;
  }
  
  @media (min-width: 768px) {
    .card-grid {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    }
  }

  @media (min-width: 1024px) {
    .card-grid {
      /* Left: 1.1fr, Middle: 0.7fr, Right (Image): 1.4fr */
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.7fr) minmax(0, 1.4fr);
    }
    .impact-stats-col {
      border-top: none;
      border-bottom: none;
      border-left: 1px solid rgba(255,255,255,0.08);
      border-right: 1px solid rgba(255,255,255,0.08);
    }
  }
  
  /* Media query for mobile adjustments in stacking */
  @media (max-width: 768px) {
    .case-study-wrapper {
      /* Disable sticky stacking on mobile to avoid cutting off tall cards */
      position: relative !important;
      top: auto !important;
      margin-bottom: 48px !important;
      z-index: 1 !important;
    }
    .cards-container {
      padding-bottom: 20vh !important;
    }
    /* Reset radius for column 3 on small screens */
    .case-study-img-col {
      border-top-right-radius: 0 !important;
      border-bottom-right-radius: 24px !important;
      border-bottom-left-radius: 24px !important;
    }
  }
</style>

<style is:global>
  @keyframes fade-slideshow {
    0%, 45% { opacity: 1; }
    50%, 95% { opacity: 0; }
    100% { opacity: 1; }
  }
</style>
