---
// Results section displaying a glimpse of the case study
---

<section id="results" style="background-color: #6E56CF; position: relative; overflow: hidden; padding: clamp(32px, 6vw, 80px) clamp(20px, 4vw, 56px) clamp(48px, 8vw, 120px); color: #F8F7FB; font-family: 'Plus Jakarta Sans', system-ui, sans-serif;">
  <!-- Matte Noisy Texture -->
  <div style="position: absolute; inset: 0; opacity: 0.3; mix-blend-mode: overlay; pointer-events: none; background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.8%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E');"></div>

  <div style="position: relative; max-width: 1400px; margin: 0 auto; z-index: 2;">
    
    <!-- Top Center Headline -->
    <div style="text-align: center; margin-bottom: clamp(32px, 5vw, 48px);">
      <h2 style="font-size: clamp(36px, 4vw, 56px); font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; margin: 0 auto; max-width: 25ch; text-wrap: balance; text-align: center; color: #FFF;">
        Real impact that builds <span style="color: #FF6B4A;">lasting partnerships.</span>
      </h2>
    </div>

    <!-- The Card -->
    <a href="/case-studies/rotimatic" style="display: block; background: linear-gradient(135deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02)); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 24px; text-decoration: none; position: relative; overflow: hidden;">
      
      <!-- CSS Grid Layout -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); align-items: stretch;">
        
        <!-- Column 1 (Left): Information & Badges -->
        <div style="padding: clamp(32px, 4vw, 64px); display: flex; flex-direction: column; justify-content: flex-start;">
          
          <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 24px;">
            <span style="display: inline-flex; align-items: center; gap: 10px; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); padding: 6px 16px 6px 6px; border-radius: 99px; font-size: 14px; font-weight: 700; color: #FFF; letter-spacing: 0.05em;">
              <span style="background: #FFF; width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                <img src="/brands/Rotimatic_Logo_.png" alt="Rotimatic Logo" style="height: 14px; width: auto; object-fit: contain;" />
              </span>
              Rotimatic
            </span>
            <span style="display: inline-flex; align-items: center; background: rgba(255, 107, 74, 0.1); border: 1px solid rgba(255, 107, 74, 0.3); padding: 6px 16px; border-radius: 99px; font-size: 14px; font-weight: 700; color: #FF6B4A; letter-spacing: 0.05em;">D2C</span>
          </div>

          <h3 style="font-size: clamp(28px, 3vw, 40px); font-weight: 800; line-height: 1.2; letter-spacing: -0.02em; color: #FFF; margin: 0 0 16px 0;">Transforming the sales pipeline for a <span style="color: #FF6B4A;">premium brand.</span></h3>
          <p style="font-size: 18px; line-height: 1.6; color: rgba(255,255,255,0.85); margin: 0 0 32px 0;">By integrating directly as an extension of the team, we completely transformed the support and sales pipeline for Rotimatic, driving massive ROI across global markets.</p>
          
          <div style="display: inline-flex; align-items: center; gap: 16px; font-size: 16px; font-weight: 700; color: #FF6B4A; margin-top: auto;">
            <span>Read full case study</span>
            <div style="width: 40px; height: 40px; border-radius: 50%; border: 1px solid rgba(255, 107, 74, 0.4); display: flex; align-items: center; justify-content: center; color: #FF6B4A;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>
        </div>

        <!-- Column 2 (Center): Stats -->
        <div class="impact-stats-col" style="padding: clamp(32px, 4vw, 64px); display: flex; flex-direction: column; justify-content: center; gap: 56px;">
          <div>
            <div style="font-family: 'JetBrains Mono', monospace; font-size: 13px; text-transform: uppercase; letter-spacing: 0.12em; color: #FF6B4A; font-weight: 700; margin-bottom: 8px;">Revenue Generated</div>
            <div style="font-size: clamp(48px, 5vw, 72px); font-weight: 800; line-height: 1; color: #FFF;">$165K</div>
          </div>
          <div>
            <div style="font-family: 'JetBrains Mono', monospace; font-size: 13px; text-transform: uppercase; letter-spacing: 0.12em; color: #FF6B4A; font-weight: 700; margin-bottom: 8px;">Pipeline Managed</div>
            <div style="font-size: clamp(48px, 5vw, 72px); font-weight: 800; line-height: 1; color: #FFF;">$450K</div>
          </div>
        </div>

        <!-- Column 3 (Right): Image -->
        <div style="display: flex; align-items: center; justify-content: center; padding: clamp(32px, 4vw, 64px);">
          <img src="/mockups/Rotimatic-img.webp" alt="Rotimatic Product Mockup" style="width: 100%; height: auto; max-height: 400px; object-fit: contain;" />
        </div>

      </div>
    </a>

  </div>
</section>

<style is:global>
  /* Responsive subtle line separation for the center column */
  .impact-stats-col {
    border-top: 1px solid rgba(255,255,255,0.08);
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  @media (min-width: 1024px) {
    .impact-stats-col {
      border-top: none;
      border-bottom: none;
      border-left: 1px solid rgba(255,255,255,0.08);
      border-right: 1px solid rgba(255,255,255,0.08);
    }
  }
</style>
