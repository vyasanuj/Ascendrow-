---
import { globalReach } from '../../data/content';
---

<section
  id="global-reach"
  style="position: relative; background: #6E56CF; color: #F8F7FB; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; overflow: hidden; padding: clamp(84px, 10vw, 150px) clamp(20px, 4vw, 56px);"
>
  <div style="position: relative; max-width: 1320px; margin: 0 auto; min-height: 500px; display: flex; align-items: center; justify-content: center;">
    <!-- World map — clearly visible but not competing with text -->
    <div
      aria-hidden="true"
      style="position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: min(1560px, 100vw); height: 100%; max-height: 640px; display: flex; align-items: center; justify-content: center; pointer-events: none; user-select: none; overflow: hidden; z-index: 1;"
    >
      <img
        src="/images/world-map.svg"
        alt=""
        loading="lazy"
        decoding="async"
        style="width: 100%; height: 100%; object-fit: contain; transform: scale(1.18); opacity: 0.2;"
      />
    </div>

    <!-- Foreground Content -->
    <div style="position: relative; z-index: 2; width: 100%; text-align: center;">
      <h2
        class="asc-global-heading"
        style="margin: 0 auto; font-size: clamp(30px, 4vw, 54px); font-weight: 800; letter-spacing: -0.035em; line-height: 1.1; color: #ffffff; white-space: nowrap; text-shadow: 0 2px 16px rgba(60, 40, 120, 0.35);"
      >
        {globalReach.title}
      </h2>

      <div
        class="asc-global-stats-grid"
        style="margin-top: clamp(60px, 7.5vw, 110px); display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(24px, 4vw, 64px); align-items: baseline; justify-content: center; max-width: 1080px; margin-left: auto; margin-right: auto;"
      >
        {
          globalReach.stats.map((stat) => (
            <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;">
              <div
                style="font-size: clamp(52px, 6.8vw, 90px); font-weight: 800; letter-spacing: -0.04em; line-height: 0.96; color: #ffffff; font-variant-numeric: tabular-nums; text-shadow: 0 2px 16px rgba(60, 40, 120, 0.35);"
              >
                {stat.value}
              </div>
              <div
                style="margin-top: clamp(12px, 1.4vw, 18px); font-size: clamp(16px, 1.45vw, 22px); font-weight: 600; letter-spacing: -0.015em; color: #F0EDF9;"
              >
                {stat.label}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style is:global>
  @media (max-width: 960px) {
    .asc-global-heading {
      font-size: clamp(22px, 3.8vw, 34px) !important;
    }
  }
  @media (max-width: 580px) {
    .asc-global-heading {
      white-space: normal !important;
      text-wrap: balance !important;
    }
    .asc-global-stats-grid {
      margin-top: 44px !important;
      gap: 16px !important;
    }
  }
</style>
